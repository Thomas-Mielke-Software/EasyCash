<!-- Diese Datei am Besten mit "git update-index --assume-unchanged" vom Tracking ausschließen, da die Einstellungen hier benutzerspezifisch sind -->
<Project>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>USE_ECTENGINE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <PropertyGroup>
    <VersionPrefix>4.0.2</VersionPrefix>
    <VersionSuffix>preview</VersionSuffix>
  </PropertyGroup>
</Project>