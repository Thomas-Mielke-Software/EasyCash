<Window x:Class="ECTViews.Stammdaten.IconAuswahlView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titel}"
        Width="640" Height="480"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="#F5F5F5"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- app-weite Button-Stile (wie im Buchen-Dialog) -->
                <ResourceDictionary Source="/ECTViews;component/GemeinsameStile.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- [Icon-Raster wie die alte CListCtrl-Icon-Ansicht] -->
        <ListBox x:Name="IconListe" Grid.Row="0"
                 ItemsSource="{Binding Icons}"
                 SelectedItem="{Binding Auswahl}"
                 MouseDoubleClick="OnDoppelklick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="False">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="86" Margin="2" ToolTip="{Binding Name}">
                        <Image Source="{Binding Icon}" Width="32" Height="32"
                               Margin="0,4,0,2" SnapsToDevicePixels="True"/>
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap"
                                   TextAlignment="Center" FontSize="11"
                                   MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- [OK / Abbrechen] -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" MinWidth="100" Height="32" Margin="0,0,8,0"
                    IsDefault="True" IsEnabled="{Binding IconGewaehlt}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnOk"/>
            <Button Content="Abbrechen" MinWidth="100" Height="32"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
