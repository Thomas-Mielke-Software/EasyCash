<Window x:Class="ECTViews.Stammdaten.KontoAnlegenView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konto anlegen"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F5F5F5"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- app-weite Button-Stile (wie im Buchen-Dialog) -->
                <ResourceDictionary Source="/ECTViews;component/GemeinsameStile.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="16">
        <!-- Hinweis: "Diese Vorlage benötigt ein Konto, das mit ..." -->
        <TextBlock x:Name="HinweisText" TextWrapping="Wrap" Foreground="#333"
                   Margin="0,0,0,12"/>

        <TextBlock Text="Kontoname:" Foreground="#333" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Padding="4,3"
                 TextChanged="OnNameGeaendert"/>

        <!-- Fehlerzeile (z.B. Name bereits vergeben) -->
        <TextBlock x:Name="FehlerText" TextWrapping="Wrap" Foreground="#C00000"
                   Margin="0,6,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="AnlegenButton" Content="Anlegen" MinWidth="100"
                    Margin="0,0,8,0" IsDefault="True" Click="OnAnlegen"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Abbrechen" MinWidth="100" IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
    </StackPanel>
</Window>
