<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:einst="clr-namespace:ECTViews.EinstellungenUi">

    <!-- Konverter: bool invertieren (Einnahme = !Ausgabe) -->
    <einst:InvertBoolConverter x:Key="InvertBool"/>

    <!-- Gemeinsame Stile für alle Einstellungs-Seiten, abgestimmt auf den
         Look von BuchungView (Segoe UI, Blau-Akzent, dezente Labels). -->

    <!-- Seiten-Überschrift -->
    <Style TargetType="TextBlock" x:Key="SeitenUeberschrift">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#1565C0"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Abschnitts-Überschrift innerhalb einer Seite -->
    <Style TargetType="TextBlock" x:Key="Abschnitt">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#444444"/>
        <Setter Property="Margin" Value="0,14,0,4"/>
    </Style>

    <!-- Feld-Beschriftung -->
    <Style TargetType="TextBlock" x:Key="FeldLabel">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <!-- Hinweistext: blau-grau, klein, kursiv -->
    <Style TargetType="TextBlock" x:Key="Hinweis">
        <Setter Property="Foreground" Value="#0277BD"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- Fehlertext unter einem Feld: rot, klein, verschwindet bei leerem Text.
         Gleiches Muster wie ErrorStyle in BuchungView. -->
    <Style TargetType="TextBlock" x:Key="FehlerText">
        <Setter Property="Foreground" Value="#D32F2F"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="Visibility" Value="Visible"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Eingabefelder -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="Margin" Value="0,3"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="Foreground" Value="#333333"/>
    </Style>

</ResourceDictionary>
