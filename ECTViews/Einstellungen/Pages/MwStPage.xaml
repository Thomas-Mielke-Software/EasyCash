<UserControl x:Class="ECTViews.EinstellungenUi.Pages.MwStPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:ECTViews.EinstellungenUi.Pages"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary Source="/ECTViews;component/Einstellungen/EinstellungenResources.xaml"/>
    </UserControl.Resources>
    <UserControl.DataContext>
        <pages:MwStPageViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="MwSt-Sätze" Style="{StaticResource SeitenUeberschrift}"/>
            <TextBlock Style="{StaticResource Hinweis}" Margin="0,0,0,8"
                       Text="Bis zu vier Mehrwertsteuersätze, die im Buchen-Dialog zur Auswahl stehen. Angabe in Prozent (z.B. 19 oder 7,5). 0 = nicht verwendet."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Satz 1 (Regelsatz)" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding Satz1}" HorizontalAlignment="Left" Width="120"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Satz 2 (ermäßigt)" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding Satz2}" HorizontalAlignment="Left" Width="120"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Satz 3" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding Satz3}" HorizontalAlignment="Left" Width="120"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Satz 4" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding Satz4}" HorizontalAlignment="Left" Width="120"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
