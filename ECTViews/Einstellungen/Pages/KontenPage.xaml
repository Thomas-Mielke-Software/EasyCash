<UserControl x:Class="ECTViews.EinstellungenUi.Pages.KontenPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:ECTViews.EinstellungenUi.Pages"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ECTViews;component/Einstellungen/EinstellungenResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <CollectionViewSource x:Key="KontenQuelle" Source="{Binding Konten}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Gruppe"/>
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>

            <Style x:Key="SpaltenKopf" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#1565C0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Padding" Value="6,5"/>
                <Setter Property="Background" Value="#F0F4F8"/>
            </Style>

            <Style x:Key="FeldItemStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="4,3"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IstZugewiesen}" Value="True">
                        <Setter Property="Background" Value="#C8E6C9"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                    <!-- Beim Konto-Drag: Felder des unpassenden Typs ausgrauen -->
                    <DataTrigger Binding="{Binding IstAusgegraut}" Value="True">
                        <Setter Property="Opacity" Value="0.30"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.DataContext>
        <pages:KontenPageViewModel/>
    </UserControl.DataContext>

    <!-- Grid mit Inhalt + Ghost-Overlay (für das schwebende Drag-Element) -->
    <Grid>
        <DockPanel Margin="24,20">
            <TextBlock DockPanel.Dock="Top" Text="E/Ü-Konten" Style="{StaticResource SeitenUeberschrift}"/>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hinweis}" Margin="0,0,0,10"
                       Text="Links die Einnahmen-/Ausgabenkonten, rechts je Formular die zuweisbaren Felder (Kz = Feldkennzeichen). Per Drag&amp;Drop ein Feld auf ein Konto (oder umgekehrt) ziehen, um es zuzuweisen; dasselbe Feld erneut zuweisen löst die Zuordnung. Konten innerhalb ihrer Gruppe per Drag&amp;Drop sortieren."/>

            <ScrollViewer x:Name="SpaltenScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          SizeChanged="OnSpaltenScrollSizeChanged">
                <StackPanel Orientation="Horizontal">

                    <!-- Konten (gruppiert) -->
                    <Border Width="{Binding SpaltenBreite}" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ZieheFeld}" Value="True">
                                        <Setter Property="BorderBrush" Value="#4CAF50"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="Background" Value="#F1F8E9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Konten" Style="{StaticResource SpaltenKopf}"/>

                            <!-- [Konto-Editor: Anlegen/Umbenennen/Löschen + Unterkategorie
                                 (steuert Einrückung/Strukturierung in der EÜR)] -->
                            <Border DockPanel.Dock="Bottom" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                                    Background="#FAFAFA" Padding="6,5">
                                <StackPanel>
                                    <!-- Neues Konto anlegen (immer aktiv) -->
                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                        <Button Content="+ Einnahmenkonto" Click="OnNeuEinnahmenkonto"
                                                Padding="0,3" Margin="0,0,2,0"/>
                                        <Button Content="+ Ausgabenkonto" Click="OnNeuAusgabenkonto"
                                                Padding="0,3" Margin="2,0,0,0"/>
                                    </UniformGrid>

                                    <!-- Editor für das gewählte Konto -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="IsEnabled" Value="True"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelektiertesKonto}" Value="{x:Null}">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Name des gewählten Kontos"
                                                   FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                                        <TextBox x:Name="KontoNameEditor"
                                                 Text="{Binding SelektiertesKonto.Name, UpdateSourceTrigger=LostFocus}"
                                                 Padding="3,2"/>
                                        <TextBlock Text="Unterkategorie"
                                                   FontSize="11" Foreground="#666666" Margin="0,6,0,2"/>
                                        <TextBox Text="{Binding SelektiertesKonto.Unterkategorie, UpdateSourceTrigger=LostFocus}"
                                                 Padding="3,2"/>
                                        <Button Content="Konto löschen" Click="OnKontoLoeschen"
                                                HorizontalAlignment="Left" Padding="8,3" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <ListBox x:Name="KontenListe"
                                     ItemsSource="{Binding Source={StaticResource KontenQuelle}}"
                                     SelectedItem="{Binding SelektiertesKonto, Mode=TwoWay}"
                                     SelectionChanged="OnKontoSelektiert"
                                     DisplayMemberPath="Name"
                                     VirtualizingPanel.IsVirtualizing="False"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     ScrollViewer.CanContentScroll="False"
                                     BorderThickness="0"
                                     PreviewMouseLeftButtonDown="OnKontoDown"
                                     PreviewMouseMove="OnDragMove"
                                     PreviewMouseLeftButtonUp="OnDragUp"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                           Foreground="#444444" Padding="6,8,6,3"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Formulare (je Kategorie eine Spalte) -->
                    <ItemsControl x:Name="FormulareListe" ItemsSource="{Binding Formulare}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pages:FormularKategorieVM}">
                                <Border Width="{Binding DataContext.SpaltenBreite,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.ZieheKonto,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Background" Value="#F1F8E9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <ComboBox DockPanel.Dock="Top"
                                                  ItemsSource="{Binding Varianten}"
                                                  SelectedItem="{Binding AusgewaehlteVariante, Mode=TwoWay}"
                                                  DisplayMemberPath="AnzeigenameKurz"
                                                  Margin="4,4,4,2"/>
                                        <Grid DockPanel.Dock="Top">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Kz" Style="{StaticResource SpaltenKopf}"/>
                                            <TextBlock Grid.Column="1" Text="Feldname" Style="{StaticResource SpaltenKopf}"/>
                                        </Grid>
                                        <ListBox ItemsSource="{Binding Felder}"
                                                 SelectedItem="{Binding AusgewaehltesFeld, Mode=TwoWay}"
                                                 ItemContainerStyle="{StaticResource FeldItemStyle}"
                                                 VirtualizingPanel.ScrollUnit="Pixel"
                                                 ScrollViewer.CanContentScroll="False"
                                                 BorderThickness="0"
                                                 SelectionChanged="OnFeldSelektiert"
                                                 PreviewMouseLeftButtonDown="OnFeldDown"
                                                 PreviewMouseMove="OnDragMove"
                                                 PreviewMouseLeftButtonUp="OnDragUp"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type pages:FormularfeldVM}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="54"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Id}"
                                                                   Foreground="#777777"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Bezeichnung}"
                                                                   TextWrapping="Wrap"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Rubber-Band-Overlay: Verbindungslinien Feld -> verknuepfte Konten -->
        <Canvas x:Name="BandLayer" IsHitTestVisible="False"/>

        <!-- Ghost-Overlay: das schwebende Drag-Element (liegt ueber den Baendern) -->
        <Canvas x:Name="GhostLayer" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
