<UserControl x:Class="ECTViews.EinstellungenUi.Pages.FinanzamtPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:ECTViews.EinstellungenUi.Pages"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary Source="/ECTViews;component/Einstellungen/EinstellungenResources.xaml"/>
    </UserControl.Resources>
    <UserControl.DataContext>
        <pages:FinanzamtPageViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Finanzamt" Style="{StaticResource SeitenUeberschrift}"/>
            <TextBlock Style="{StaticResource Hinweis}" Margin="0,0,0,8"
                       Text="Stammdaten des zuständigen Finanzamts. Erscheinen auf den amtlichen Formularen (USt-Voranmeldung, EÜR)."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Namenszusatz" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding Name2, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Straße" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding Strasse, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="PLZ" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding Plz, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" HorizontalAlignment="Left" Width="120"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ort" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="4" Grid.Column="1" Text="{Binding Ort, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Steuernummer" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="5" Grid.Column="1" Text="{Binding Steuernummer, UpdateSourceTrigger=PropertyChanged}" MaxLength="19"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Wirtschafts-ID-Nr." Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="6" Grid.Column="1" MaxLength="17" Text="{Binding WirtschaftsId, UpdateSourceTrigger=PropertyChanged}">
                    <!-- Info-Tooltip: erklaert Aufbau und Hintergrund der W-IdNr. -->
                    <TextBox.ToolTip>
                        <ToolTip MaxWidth="360">
                            <TextBlock TextWrapping="Wrap">
                                Wirtschafts-Identifikationsnummer (W-IdNr.): bundeseinheitliche Nummer für wirtschaftlich Tätige, die das Bundeszentralamt für Steuern seit Ende 2024 automatisch vergibt (keine Beantragung nötig).<LineBreak/><LineBreak/>
                                Aufbau: Länderkürzel (2 Buchstaben) + 9 Ziffern + Bindestrich + 5-stelliges Unterscheidungsmerkmal, z.B. DE123456789-00001 (17 Zeichen). Der vordere Teil entspricht der USt-IdNr.; das Unterscheidungsmerkmal (00001, 00002, ...) steht für die einzelne wirtschaftliche Tätigkeit.<LineBreak/><LineBreak/>
                                Das Feld darf leer bleiben.
                            </TextBlock>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <!-- Validierungsfehler in Rot unter dem Feld, wie im Buchen-Dialog. -->
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding WirtschaftsIdFehler}"
                           Style="{StaticResource FehlerText}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
