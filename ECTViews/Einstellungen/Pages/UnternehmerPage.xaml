<UserControl x:Class="ECTViews.EinstellungenUi.Pages.UnternehmerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:ECTViews.EinstellungenUi.Pages"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary Source="/ECTViews;component/Einstellungen/EinstellungenResources.xaml"/>
    </UserControl.Resources>
    <UserControl.DataContext>
        <pages:UnternehmerPageViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Unternehmer" Style="{StaticResource SeitenUeberschrift}"/>
            <TextBlock Style="{StaticResource Hinweis}" Margin="0,0,0,8"
                       Text="Persönliche Stammdaten. Das Land bestimmt die Vorgaben für Steuersätze und AfA-Regeln."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding Name}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Vorname" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding Vorname}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Straße" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding Strasse}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="PLZ" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding Plz}" HorizontalAlignment="Left" Width="120"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ort" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="4" Grid.Column="1" Text="{Binding Ort}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Land" Style="{StaticResource FeldLabel}"/>
                <ComboBox Grid.Row="5" Grid.Column="1" SelectedIndex="{Binding Land}"
                          HorizontalAlignment="Left" Width="220">
                    <ComboBoxItem Content="Deutschland"/>
                    <ComboBoxItem Content="Österreich"/>
                    <ComboBoxItem Content="Schweiz"/>
                </ComboBox>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Unternehmensart" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="6" Grid.Column="1" Text="{Binding Unternehmensart1}"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Unternehmensart (2)" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="7" Grid.Column="1" Text="{Binding Unternehmensart2}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
