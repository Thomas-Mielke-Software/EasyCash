<UserControl x:Class="ECTViews.EinstellungenUi.Pages.PresetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:ECTViews.EinstellungenUi.Pages"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary Source="/ECTViews;component/Einstellungen/EinstellungenResources.xaml"/>
    </UserControl.Resources>
    <UserControl.DataContext>
        <pages:PresetsPageViewModel/>
    </UserControl.DataContext>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Buchungs-Presets" Style="{StaticResource SeitenUeberschrift}"/>
        <TextBlock Grid.Row="1" Style="{StaticResource Hinweis}" Margin="0,0,0,10"
                   Text="Vorlagen für häufige Buchungen. Die Notiz wird im Buchen-Dialog beim Auswählen des Presets kurz als Hinweis-Balloon eingeblendet."/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Master: Liste der Presets + Buttons -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Neu" Command="{Binding NeuCommand}"
                            Padding="12,4" Margin="0,0,6,0"/>
                    <Button Content="Löschen" Command="{Binding LoeschenCommand}"
                            Padding="12,4"/>
                </StackPanel>
                <Border BorderBrush="#E0E0E0" BorderThickness="1">
                    <ListBox ItemsSource="{Binding Presets}"
                             SelectedItem="{Binding Ausgewaehlt, Mode=TwoWay}"
                             DisplayMemberPath="Anzeige"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- Detail: Editor des ausgewählten Presets -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          DataContext="{Binding Ausgewaehlt}">
                <Grid Margin="6,0,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Beschreibung" Style="{StaticResource FeldLabel}"/>
                    <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding Beschreibung, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Art" Style="{StaticResource FeldLabel}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                        <RadioButton Content="Einnahme" IsChecked="{Binding IstAusgabe, Converter={StaticResource InvertBool}}"
                                     VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <RadioButton Content="Ausgabe" IsChecked="{Binding IstAusgabe}"
                                     VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Konto" Style="{StaticResource FeldLabel}"/>
                    <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding Konto, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="MwSt %" Style="{StaticResource FeldLabel}"/>
                    <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding MwstProzent, UpdateSourceTrigger=LostFocus}"
                              HorizontalAlignment="Left" Width="100"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="AfA-Jahre" Style="{StaticResource FeldLabel}"/>
                    <TextBox  Grid.Row="4" Grid.Column="1" Text="{Binding AfaJahre, UpdateSourceTrigger=LostFocus}"
                              HorizontalAlignment="Left" Width="100"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="AfA degressiv" Style="{StaticResource FeldLabel}"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                        <CheckBox Content="degressiv" IsChecked="{Binding IstDegressiv}"
                                  VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Text="Satz %" Style="{StaticResource FeldLabel}"
                                   IsEnabled="{Binding IstDegressiv}"/>
                        <TextBox Text="{Binding DegressivSatz, UpdateSourceTrigger=LostFocus}"
                                 Width="60" IsEnabled="{Binding IstDegressiv}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Notiz" Style="{StaticResource FeldLabel}"
                               VerticalAlignment="Top" Margin="0,6,10,0"/>
                    <TextBox  Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                              Text="{Binding Notiz, UpdateSourceTrigger=LostFocus}"
                              AcceptsReturn="True" TextWrapping="Wrap"
                              VerticalContentAlignment="Top"
                              VerticalScrollBarVisibility="Auto"
                              MinHeight="80" Margin="0,3"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
