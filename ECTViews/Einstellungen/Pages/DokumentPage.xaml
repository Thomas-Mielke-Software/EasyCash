<UserControl x:Class="ECTViews.EinstellungenUi.Pages.DokumentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary Source="/ECTViews;component/Einstellungen/EinstellungenResources.xaml"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Aktuelles Dokument" Style="{StaticResource SeitenUeberschrift}"/>
            <TextBlock Style="{StaticResource Hinweis}" Margin="0,0,0,8"
                       Text="Diese Werte gehören zum aktuell geöffneten Dokument und werden mit ihm gespeichert. Andere Dokumente bleiben unberührt."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Buchungsjahr" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding Buchungsjahr, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="120"/>
            </Grid>
            <TextBlock Style="{StaticResource Hinweis}"
                       Text="Gültiger Bereich: 1980 bis 3000."/>

            <!-- [Optische Trennung] -->
            <Border BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Margin="0,18,0,0"/>

            <TextBlock Text="Laufende Belegnummern" Style="{StaticResource Abschnitt}"/>
            <TextBlock Style="{StaticResource Hinweis}" Margin="0,0,0,8"
                       Text="Nächste automatisch vergebene Belegnummer je Buchungsart. Wird nur verwendet, wenn die automatische Belegnummern-Vergabe (Seite 'Allgemein') für die jeweilige Art aktiviert ist."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Einnahmen" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding BelegnrEinnahmen, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="120"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ausgaben" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding BelegnrAusgaben, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="120"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Bank" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding BelegnrBank, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="120"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Kasse" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding BelegnrKasse, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="120"/>
            </Grid>

            <!-- [Optische Trennung] -->
            <Border BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Margin="0,18,0,0"/>

            <TextBlock Text="Dauerfristverlängerung" Style="{StaticResource Abschnitt}"/>
            <TextBlock Style="{StaticResource Hinweis}" Margin="0,0,0,8"
                       Text="Bei beantragter Dauerfristverlängerung geleistete Sondervorauszahlung (ein Elftel der Summe aller USt-Vorauszahlungen des Vorjahres) für dieses Buchungsjahr. Wird in der letzten USt-Voranmeldung des Jahres verrechnet. Leer lassen, wenn keine Sondervorauszahlung geleistet wurde."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Sondervorauszahlung" Style="{StaticResource FeldLabel}"/>
                <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding Sondervorauszahlung, UpdateSourceTrigger=LostFocus}" HorizontalAlignment="Left" Width="120"/>

                <!-- Validierungsfehler in Rot unter dem Feld, wie im Buchen-Dialog. -->
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SondervorauszahlungFehler}"
                           Style="{StaticResource FehlerText}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
