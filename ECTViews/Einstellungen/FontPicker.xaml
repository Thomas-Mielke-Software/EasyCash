<UserControl x:Class="ECTViews.EinstellungenUi.FontPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ECTViews.EinstellungenUi"
             x:Name="root"
             FontFamily="Segoe UI" FontSize="13" Margin="0,2">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Beschriftung (z.B. "Bildschirm" / "Drucker") -->
        <TextBlock Grid.Column="0" Text="{Binding Beschriftung, ElementName=root}"
                   MinWidth="80" VerticalAlignment="Center"
                   Foreground="#333333" Margin="0,0,10,0"/>

        <!-- Schriftfamilie: editierbare Liste, jeder Eintrag in seiner
             eigenen Schrift als Vorschau gerendert. -->
        <ComboBox Grid.Column="1" IsEditable="True" MaxDropDownHeight="320"
                  ItemsSource="{Binding FontFamilien, ElementName=root}"
                  Text="{Binding SchriftName, ElementName=root,
                                 UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Schriftgröße -->
        <TextBlock Grid.Column="2" Text="Größe" VerticalAlignment="Center"
                   Foreground="#333333" Margin="10,0,10,0"
                   ToolTip="{x:Static local:FontPicker.GroessenHinweis}"/>
        <ComboBox Grid.Column="3" IsEditable="True" Width="70"
                  ItemsSource="{Binding Groessen, ElementName=root}"
                  ToolTip="{x:Static local:FontPicker.GroessenHinweis}"
                  ToolTipService.ShowDuration="20000"
                  Text="{Binding SchriftGroesse, ElementName=root,
                                 UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
    </Grid>
</UserControl>
