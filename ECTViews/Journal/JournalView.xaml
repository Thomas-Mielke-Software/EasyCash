<UserControl x:Class="ECTViews.Journal.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:journal="clr-namespace:ECTViews.Journal"
             FontFamily="Segoe UI"
             Background="White"
             SizeChanged="OnControlSizeChanged">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="ColEinnahme"  Color="#1030D0"/>
        <SolidColorBrush x:Key="ColAusgabe"   Color="#C62828"/>
        <SolidColorBrush x:Key="ColZebraOdd"  Color="#F5F5F5"/>
        <SolidColorBrush x:Key="ColSelection" Color="#FFF59D"/>
        <SolidColorBrush x:Key="ColHeaderBg"  Color="#FAFAFA"/>
        <SolidColorBrush x:Key="ColBorder"    Color="#888888"/>

        <!-- Spaltenbreiten als Resources für die fixen Spalten.
             Die Belegspalte hat eine globale, für das ganze Journal
             konstante Breite (ViewModel.BelegSpaltenBreite), berechnet
             einmal pro Aktualisiere aus dem 95-Perzentil aller
             Belegnummer-Längen. Längere Belegnummern werden im
             TextBlock per TextTrimming="CharacterEllipsis" abgekürzt.
             Früher war das ein Auto+SharedSizeGroup-Layout, das beim
             Scrollen in Bereiche mit anderen Belegnummer-Längen
             ruckartig die Spaltenbreite verändert hat. -->
        <GridLength x:Key="ColW_Icon">28</GridLength>
        <GridLength x:Key="ColW_Datum">90</GridLength>
        <GridLength x:Key="ColW_Brutto">110</GridLength>
        <GridLength x:Key="ColW_AfA">60</GridLength>

        <DataTemplate DataType="{x:Type journal:JournalSectionTitle}">
            <TextBlock Text="{Binding Text}"
                       Margin="6,12,6,4"
                       FontWeight="Bold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="15"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMain}" Value="True">
                                <Setter Property="FontSize" Value="17"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEinnahme}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ColEinnahme}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEinnahme}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource ColAusgabe}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <DataTemplate DataType="{x:Type journal:JournalHeaderRow}">
            <Border Background="{StaticResource ColHeaderBg}"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource ColBorder}"
                    Padding="0,4,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource ColW_Icon}"/>
                        <ColumnDefinition Width="{StaticResource ColW_Icon}"/>
                        <ColumnDefinition Width="{StaticResource ColW_Datum}"/>
                        <ColumnDefinition Width="Auto"
                                      MinWidth="{Binding DataContext.BelegSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      MaxWidth="{Binding DataContext.BelegSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="Auto"
                                      MinWidth="{Binding DataContext.NettoSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      MaxWidth="{Binding DataContext.NettoSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="Auto"
                                      MinWidth="{Binding DataContext.UStSatzSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      MaxWidth="{Binding DataContext.UStSatzSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="Auto"
                                      MinWidth="{Binding DataContext.UStBetragSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      MaxWidth="{Binding DataContext.UStBetragSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="{StaticResource ColW_Brutto}"/>
                        <ColumnDefinition Width="Auto"
                                          MinWidth="{Binding DataContext.SaldoSpaltenBreite,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          MaxWidth="{Binding DataContext.SaldoSpaltenBreite,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="{StaticResource ColW_AfA}"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="2" Text="Datum" FontWeight="SemiBold"
                               Margin="4,0"/>
                    <TextBlock Grid.Column="3" Text="Beleg" FontWeight="SemiBold"
                               Margin="4,0"
                               Visibility="{Binding ZeigeBelegnummer,
                                   Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Column="4" Text="Beschreibung"
                               FontWeight="SemiBold" Margin="4,0"/>
                    <TextBlock Grid.Column="5" Text="Netto" FontWeight="SemiBold"
                               TextAlignment="Right" Margin="4,0"
                               Visibility="{Binding ZeigeSteuer,
                                   Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Column="6" FontWeight="SemiBold"
                               TextAlignment="Right" Margin="4,0"
                               Visibility="{Binding ZeigeSteuer,
                                   Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="USt"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAusgabe}" Value="True">
                                        <Setter Property="Text" Value="VSt"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="7" FontWeight="SemiBold"
                               TextAlignment="Right" Margin="4,0"
                               Visibility="{Binding ZeigeSteuer,
                                   Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="USt-Betr"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAusgabe}" Value="True">
                                        <Setter Property="Text" Value="VSt-Betr"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="8" Text="Brutto"
                               FontWeight="SemiBold" TextAlignment="Right" Margin="4,0"/>
                    <TextBlock Grid.Column="9" Text="Saldo"
                               FontWeight="SemiBold" TextAlignment="Right" Margin="4,0"
                               Visibility="{Binding ZeigeSaldo,
                                   Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Column="10" Text="AfA-Nr"
                               FontWeight="SemiBold" TextAlignment="Right" Margin="4,0"
                               Visibility="{Binding ZeigeAfaNr,
                                   Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type journal:JournalBuchungRow}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource ColW_Icon}"/>
                    <ColumnDefinition Width="{StaticResource ColW_Icon}"/>
                    <ColumnDefinition Width="{StaticResource ColW_Datum}"/>
                    <ColumnDefinition Width="Auto"
                                      MinWidth="{Binding DataContext.BelegSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      MaxWidth="{Binding DataContext.BelegSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="Auto"
                                      MinWidth="{Binding DataContext.NettoSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      MaxWidth="{Binding DataContext.NettoSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <ColumnDefinition Width="Auto"
                                      MinWidth="{Binding DataContext.UStSatzSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      MaxWidth="{Binding DataContext.UStSatzSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <ColumnDefinition Width="Auto"
                                      MinWidth="{Binding DataContext.UStBetragSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      MaxWidth="{Binding DataContext.UStBetragSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <ColumnDefinition Width="{StaticResource ColW_Brutto}"/>
                    <ColumnDefinition Width="Auto"
                                      MinWidth="{Binding DataContext.SaldoSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      MaxWidth="{Binding DataContext.SaldoSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <ColumnDefinition Width="{StaticResource ColW_AfA}"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="{Binding BetriebIcon}"
                       Width="20" Height="20" Stretch="Uniform"
                       VerticalAlignment="Top" HorizontalAlignment="Center"
                       Margin="0,2,0,0"/>
                <Image Grid.Column="1" Source="{Binding BestandskontoIcon}"
                       Width="20" Height="20" Stretch="Uniform"
                       VerticalAlignment="Top" HorizontalAlignment="Center"
                       Margin="0,2,0,0"/>

                <TextBlock Grid.Column="2" Text="{Binding DatumText}"
                           Margin="4,0" VerticalAlignment="Top"/>

                <TextBlock Grid.Column="3" Text="{Binding BelegText}"
                           Margin="4,0" VerticalAlignment="Top"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding BelegText}"/>

                <!-- Beschreibung wickelt sich um, wenn zu lang -->
                <TextBlock Grid.Column="4" Text="{Binding BeschreibungText}"
                           Margin="4,0" VerticalAlignment="Top"
                           TextWrapping="Wrap"/>

                <TextBlock Grid.Column="5" Text="{Binding NettoText}"
                           TextAlignment="Right" Margin="4,0"
                           VerticalAlignment="Top"
                           FontFamily="Consolas"/>
                <TextBlock Grid.Column="6" Text="{Binding MwstSatzText}"
                           TextAlignment="Right" Margin="4,0"
                           VerticalAlignment="Top"/>
                <TextBlock Grid.Column="7" Text="{Binding MwstBetragText}"
                           TextAlignment="Right" Margin="4,0"
                           VerticalAlignment="Top"
                           FontFamily="Consolas"/>

                <TextBlock Grid.Column="8" Text="{Binding BruttoText}"
                           TextAlignment="Right" Margin="4,0"
                           VerticalAlignment="Top" FontWeight="SemiBold"
                           FontFamily="Consolas"/>

                <!-- Laufender Saldo (nur im Bestandskonten-Modus gefüllt) -->
                <TextBlock Grid.Column="9" Text="{Binding SaldoText}"
                           TextAlignment="Right" Margin="4,0"
                           VerticalAlignment="Top" FontWeight="SemiBold"
                           FontFamily="Consolas"/>

                <TextBlock Grid.Column="10" Text="{Binding AfaNrText}"
                           TextAlignment="Right" Margin="4,0"
                           VerticalAlignment="Top"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type journal:JournalFooterRow}">
            <Border BorderThickness="0,1,0,1"
                    BorderBrush="{StaticResource ColBorder}"
                    Padding="0,4,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource ColW_Icon}"/>
                        <ColumnDefinition Width="{StaticResource ColW_Icon}"/>
                        <ColumnDefinition Width="{StaticResource ColW_Datum}"/>
                        <ColumnDefinition Width="Auto"
                                      MinWidth="{Binding DataContext.BelegSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      MaxWidth="{Binding DataContext.BelegSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="Auto"
                                      MinWidth="{Binding DataContext.NettoSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      MaxWidth="{Binding DataContext.NettoSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="Auto"
                                      MinWidth="{Binding DataContext.UStSatzSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      MaxWidth="{Binding DataContext.UStSatzSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="Auto"
                                      MinWidth="{Binding DataContext.UStBetragSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      MaxWidth="{Binding DataContext.UStBetragSpaltenBreite,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="{StaticResource ColW_Brutto}"/>
                        <ColumnDefinition Width="Auto"
                                          MinWidth="{Binding DataContext.SaldoSpaltenBreite,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          MaxWidth="{Binding DataContext.SaldoSpaltenBreite,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="{StaticResource ColW_AfA}"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="4" Text="{Binding LinkesLabel}"
                               FontWeight="Bold" Margin="4,0"/>

                    <TextBlock Grid.Column="5" Text="{Binding NettoSummeText}"
                               TextAlignment="Right" Margin="4,0"
                               FontWeight="Bold" FontFamily="Consolas"
                               Visibility="{Binding ZeigeSteuer,
                                   Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Column="7" Text="{Binding SteuerSummeText}"
                               TextAlignment="Right" Margin="4,0"
                               FontWeight="Bold" FontFamily="Consolas"
                               Visibility="{Binding ZeigeSteuer,
                                   Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Column="8" Text="{Binding BruttoSummeText}"
                               TextAlignment="Right" Margin="4,0"
                               FontWeight="Bold" FontFamily="Consolas"/>
                    <!-- Endsaldo (nur im Bestandskonten-Modus gefüllt) -->
                    <TextBlock Grid.Column="9" Text="{Binding SaldoSummeText}"
                               TextAlignment="Right" Margin="4,0"
                               FontWeight="Bold" FontFamily="Consolas"/>
                    <!-- Waehrung in der AfA-Spaltenposition. Rechtes Margin
                         (20px) verhindert, dass der vertikale Scrollbar
                         den Text abschneidet. -->
                    <TextBlock Grid.Column="10" Text="{Binding Waehrung}"
                               TextAlignment="Right" Margin="4,0,20,0"
                               FontWeight="Bold"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type journal:JournalSpacerRow}">
            <Rectangle Height="{Binding Height}" Fill="Transparent"/>
        </DataTemplate>

        <!-- [Anlagenverzeichnis-Templates]
             Eigener Spaltensatz: Icon|Icon|Beschreibung|Ansch.Datum|
             Ansch.kosten|Buchw.Beginn|AfA|Abgänge|Buchw.Ende|AfA-Nr.
             Spaltenbreiten: Icons fest, Datum fest, Beschreibung star,
             alle Geldspalten ColW_Brutto, AfA-Nr ColW_AfA. -->
        <DataTemplate DataType="{x:Type journal:JournalAnlagenHeaderRow}">
            <Border Background="{StaticResource ColHeaderBg}"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource ColBorder}"
                    Padding="0,4,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource ColW_Icon}"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="{StaticResource ColW_Datum}"/>
                        <ColumnDefinition Width="{StaticResource ColW_Brutto}"/>
                        <ColumnDefinition Width="{StaticResource ColW_Brutto}"/>
                        <ColumnDefinition Width="{StaticResource ColW_Brutto}"/>
                        <ColumnDefinition Width="{StaticResource ColW_Brutto}"/>
                        <ColumnDefinition Width="{StaticResource ColW_Brutto}"/>
                        <ColumnDefinition Width="{StaticResource ColW_AfA}"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Beschreibung" FontWeight="SemiBold" Margin="4,0"/>
                    <TextBlock Grid.Column="2" Text="Ansch.Datum"  FontWeight="SemiBold" Margin="4,0"/>
                    <TextBlock Grid.Column="3" Text="Ansch.kosten" FontWeight="SemiBold" TextAlignment="Right" Margin="4,0"/>
                    <TextBlock Grid.Column="4" Text="Buchw.Beginn" FontWeight="SemiBold" TextAlignment="Right" Margin="4,0"/>
                    <TextBlock Grid.Column="5" Text="AfA"          FontWeight="SemiBold" TextAlignment="Right" Margin="4,0"/>
                    <TextBlock Grid.Column="6" Text="Abgänge"      FontWeight="SemiBold" TextAlignment="Right" Margin="4,0"/>
                    <TextBlock Grid.Column="7" Text="Buchw.Ende"   FontWeight="SemiBold" TextAlignment="Right" Margin="4,0"/>
                    <TextBlock Grid.Column="8" Text="AfA-Nr"       FontWeight="SemiBold" TextAlignment="Right" Margin="4,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type journal:JournalAnlagenRow}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource ColW_Icon}"/>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="{StaticResource ColW_Datum}"/>
                    <ColumnDefinition Width="{StaticResource ColW_Brutto}"/>
                    <ColumnDefinition Width="{StaticResource ColW_Brutto}"/>
                    <ColumnDefinition Width="{StaticResource ColW_Brutto}"/>
                    <ColumnDefinition Width="{StaticResource ColW_Brutto}"/>
                    <ColumnDefinition Width="{StaticResource ColW_Brutto}"/>
                    <ColumnDefinition Width="{StaticResource ColW_AfA}"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="{Binding BetriebIcon}"
                       Width="20" Height="20" Stretch="Uniform"
                       VerticalAlignment="Top" HorizontalAlignment="Center"
                       Margin="0,2,0,0"/>

                <TextBlock Grid.Column="1" Text="{Binding BeschreibungText}"
                           Margin="4,0" VerticalAlignment="Top"
                           TextWrapping="Wrap"/>
                <TextBlock Grid.Column="2" Text="{Binding AnschDatumText}"
                           Margin="4,0" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="3" Text="{Binding AnschKostenText}"
                           TextAlignment="Right" Margin="4,0"
                           VerticalAlignment="Top" FontFamily="Consolas"/>
                <TextBlock Grid.Column="4" Text="{Binding BuchwBeginnText}"
                           TextAlignment="Right" Margin="4,0"
                           VerticalAlignment="Top" FontFamily="Consolas"/>
                <TextBlock Grid.Column="5" Text="{Binding AfaJahresbetragText}"
                           TextAlignment="Right" Margin="4,0"
                           VerticalAlignment="Top" FontFamily="Consolas"/>
                <TextBlock Grid.Column="6" Text="{Binding AbgangText}"
                           TextAlignment="Right" Margin="4,0"
                           VerticalAlignment="Top" FontFamily="Consolas"/>
                <TextBlock Grid.Column="7" Text="{Binding BuchwEndeText}"
                           TextAlignment="Right" Margin="4,0"
                           VerticalAlignment="Top" FontWeight="SemiBold"
                           FontFamily="Consolas"/>
                <TextBlock Grid.Column="8" Text="{Binding AfaNrText}"
                           TextAlignment="Right" Margin="4,0"
                           VerticalAlignment="Top"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type journal:JournalAnlagenFooterRow}">
            <Border BorderThickness="0,1,0,1"
                    BorderBrush="{StaticResource ColBorder}"
                    Padding="0,4,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource ColW_Icon}"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="{StaticResource ColW_Datum}"/>
                        <ColumnDefinition Width="{StaticResource ColW_Brutto}"/>
                        <ColumnDefinition Width="{StaticResource ColW_Brutto}"/>
                        <ColumnDefinition Width="{StaticResource ColW_Brutto}"/>
                        <ColumnDefinition Width="{StaticResource ColW_Brutto}"/>
                        <ColumnDefinition Width="{StaticResource ColW_Brutto}"/>
                        <ColumnDefinition Width="{StaticResource ColW_AfA}"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="3" Text="{Binding AnschKostenSummeText}"
                               TextAlignment="Right" Margin="4,0"
                               FontWeight="Bold" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="5" Text="{Binding AfaSummeText}"
                               TextAlignment="Right" Margin="4,0"
                               FontWeight="Bold" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="6" Text="{Binding AbgangSummeText}"
                               TextAlignment="Right" Margin="4,0"
                               FontWeight="Bold" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="7" Text="{Binding BuchwEndeSummeText}"
                               TextAlignment="Right" Margin="4,0"
                               FontWeight="Bold" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="8" Text="{Binding Waehrung}"
                               TextAlignment="Right" Margin="4,0,20,0"
                               FontWeight="Bold"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="JournalRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BuchungRowStyle" TargetType="ListBoxItem"
               BasedOn="{StaticResource JournalRowStyle}">
            <Setter Property="Focusable" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=., Converter={x:Static journal:ZebraConverter.Instance}}"
                             Value="True">
                    <Setter Property="Background" Value="{StaticResource ColZebraOdd}"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ColSelection}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <ListBox x:Name="lstZeilen"
                 ItemsSource="{Binding Zeilen}"
                 SelectedItem="{Binding SelektierteZeile}"
                 SelectionMode="Extended"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Standard"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 FontSize="{Binding Schriftgroesse}"
                 KeyboardNavigation.DirectionalNavigation="Continue"
                 ItemContainerStyleSelector="{x:Static journal:JournalRowStyleSelector.Instance}"
                 MouseDoubleClick="OnZeilenDoppelklick"
                 PreviewKeyDown="OnListBoxPreviewKeyDown"
                 SelectionChanged="OnSelectionChanged">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Ändern" Command="{Binding BearbeitenCommand}"/>
                    <MenuItem Header="Löschen" Command="{Binding LoeschenCommand}"/>
                    <Separator/>
                    <MenuItem Header="Kopieren" Command="{Binding KopierenCommand}"/>
                    <MenuItem Header="Kopieren mit neuer Belegnummer"
                              Command="{Binding KopierenMitNeuerBelegnummerCommand}"/>
                    <Separator/>
                    <MenuItem Header="AfA-Abgang buchen"
                              Command="{Binding AfaAbgangCommand}"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </Grid>
</UserControl>
