<Window x:Class="ECTViews.Formulare.FormularAbschnittDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Formular-Abschnitt"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F5F5F5"
        FontFamily="Segoe UI" FontSize="13">

    <!-- [Abschnitts-Eigenschaften]
         Pendant des nativen CFormularabschnitt-Dialogs: Navigationsanker
         (Name + Seite + Promille-Vertikalposition) der Seitenleiste. -->

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,8,6"/>
        <TextBox Grid.Column="1" x:Name="NameBox" Padding="4,3" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1" Text="Position:" VerticalAlignment="Center"
                   Margin="0,0,8,6"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
            <TextBlock Text="Seite" VerticalAlignment="Center" Margin="0,0,4,6"/>
            <TextBox x:Name="SeiteBox" Width="46" Padding="4,3" Margin="0,0,0,6"/>
            <TextBlock Text="vertikal" VerticalAlignment="Center" Margin="10,0,4,6"/>
            <TextBox x:Name="VertikalBox" Width="60" Padding="4,3" Margin="0,0,0,6"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" x:Name="FehlerText"
                   Foreground="#D32F2F" FontSize="11" FontStyle="Italic"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Speichern" MinWidth="100" Padding="14,5"
                    Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
            <Button Content="Abbrechen" MinWidth="100" Padding="14,5"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
