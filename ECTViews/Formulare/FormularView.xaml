<UserControl x:Class="ECTViews.Formulare.FormularView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:formulare="clr-namespace:ECTViews.Formulare"
             Background="#FF505860"
             Focusable="True"
             PreviewKeyDown="OnPreviewKeyDown"
             PreviewMouseWheel="OnPreviewMouseWheel">

    <!-- [Formular-Ansicht]
         Zeigt eine .ecf-Formulardefinition: pro Seite der amtliche
         Formularscan (PNG) mit absolut positionierten Feldwerten darueber.
         Links die Abschnitts-/Seitenleiste (Pendant der nativen
         Formular-Seitenleiste), rechts die scrollbaren Seiten. Zoom via
         ScaleTransform (Skala), damit Feldtext und PNG deckungsgleich
         bleiben; Strg+P druckt (Code-Behind, Muster BerichtView).

         Designer-Modus (Kontextmenue "Felder anzeigen/bearbeiten",
         Pendant m_bFormularfelderAnzeigen): Felder mit Rahmen (rosa,
         Auswahl blau), Drag mit linker Maustaste (Strg-Klick =
         Mehrfachauswahl), Pfeiltasten = Feinjustage, Doppelklick =
         Eigenschaften-Dialog. Aenderungen gehen sofort in die .ecf. -->

    <UserControl.ContextMenu>
        <ContextMenu Opened="OnKontextmenuOeffnet">
            <MenuItem x:Name="MenuDesigner"
                      Header="Felder anzeigen/bearbeiten"
                      IsCheckable="True"
                      IsChecked="{Binding DesignerAktiv, Mode=TwoWay}"/>
            <Separator/>
            <MenuItem x:Name="MenuFeldBearbeiten" Header="Feld bearbeiten..."
                      Click="OnFeldBearbeiten"/>
            <MenuItem x:Name="MenuFeldLoeschen" Header="Feld löschen"
                      Click="OnFeldLoeschen"/>
            <MenuItem x:Name="MenuNeuesFeld" Header="Neues Feld hier erzeugen"
                      Click="OnNeuesFeld"/>
            <MenuItem x:Name="MenuNeuerAbschnitt" Header="Neuen Abschnitt hier erzeugen"
                      Click="OnNeuerAbschnitt"/>
            <Separator/>
            <MenuItem x:Name="MenuFeldwertKopieren"
                      Header="Feldwert in die Zwischenablage kopieren"
                      Click="OnFeldwertKopieren"/>
            <MenuItem Header="Formulardatei im Editor öffnen"
                      Click="OnDateiOeffnen"/>
        </ContextMenu>
    </UserControl.ContextMenu>

    <DockPanel>

        <!-- Abschnitts-/Seitenleiste -->
        <Border DockPanel.Dock="Left" Background="#FFF2F2F2"
                BorderBrush="#FFB0B0B0" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HatNavigation}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ListBox x:Name="NavigationListe" Width="210"
                     ItemsSource="{Binding Navigation}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnNavigationClick">
                <ListBox.ContextMenu>
                    <ContextMenu Opened="OnNavKontextmenuOeffnet">
                        <MenuItem x:Name="MenuAbschnittBearbeiten"
                                  Header="Abschnitt bearbeiten..."
                                  Click="OnAbschnittBearbeiten"/>
                        <MenuItem x:Name="MenuAbschnittLoeschen"
                                  Header="Abschnitt löschen"
                                  Click="OnAbschnittLoeschen"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="8,3,4,3"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type formulare:FormularNavigationItem}">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Margin" Value="10,0,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IstSeite}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Margin" Value="0,6,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Seiten -->
        <ScrollViewer x:Name="SeitenScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Padding="16">
            <Grid HorizontalAlignment="Center">

                <!-- Ladefehler (Pendant "Formular ... konnte nicht gefunden werden.") -->
                <TextBlock Text="{Binding Fehlertext}"
                           Foreground="White" FontSize="14" Margin="24"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HatFehler}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl x:Name="SeitenListe" ItemsSource="{Binding Seiten}">
                    <ItemsControl.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Skala}"
                                        ScaleY="{Binding Skala}"/>
                    </ItemsControl.LayoutTransform>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type formulare:FormularSeiteVm}">
                            <Border Background="White"
                                    BorderBrush="#FF808080" BorderThickness="1"
                                    Margin="0,0,0,16"
                                    SnapsToDevicePixels="True">
                                <Grid Width="{Binding Breite}" Height="{Binding Hoehe}"
                                      Background="White"
                                      MouseLeftButtonDown="OnSeiteMouseDown"
                                      MouseMove="OnSeiteMouseMove"
                                      MouseLeftButtonUp="OnSeiteMouseUp"
                                      MouseRightButtonDown="OnSeiteRechtsklick">

                                    <!-- Formularscan; DPI-Metadaten der PNGs sind
                                         uneinheitlich -> feste Groesse + Fill -->
                                    <Image Source="{Binding Bild}"
                                           Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HatBild}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <!-- Feldwerte, absolut positioniert; Felder mit
                                         horizontal > 1000 ragen wie nativ ueber den
                                         Seitenrand (kein Clipping) -->
                                    <ItemsControl ItemsSource="{Binding Felder}"
                                                  ClipToBounds="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas ClipToBounds="False"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                                <Setter Property="Canvas.Right" Value="{Binding Right}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type formulare:FormularFeldVm}">
                                                <!-- Rahmen nur im Designer sichtbar; Margin
                                                     kompensiert Rahmen+Innenabstand, damit der
                                                     Text exakt an der Ankerposition bleibt -->
                                                <Border BorderBrush="{Binding RahmenBrush}"
                                                        BorderThickness="1"
                                                        Padding="1,0,1,0"
                                                        Margin="-2,-1,-2,-1"
                                                        Background="Transparent">
                                                    <TextBlock Text="{Binding Text}"
                                                               FontSize="{Binding FontSize}"
                                                               Foreground="{Binding Foreground}"
                                                               FontFamily="{Binding DataContext.Schriftart,
                                                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               ToolTip="{Binding Tooltip}"
                                                               ToolTipService.InitialShowDelay="400"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
