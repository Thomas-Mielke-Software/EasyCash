<Window x:Class="ECTViews.UstAbgleichUi.UstAbgleichView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zuordnungen für Voranmeldung und Umsatzsteuererklärung abgleichen"
        Width="1180" Height="560" MinWidth="640" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="#F5F5F5"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ECTViews;component/GemeinsameStile.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Lange Feldnamen abschneiden, vollständig im Tooltip -->
            <Style x:Key="ZellText" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding HinweisText}" TextWrapping="Wrap"
                   Foreground="#333" Margin="0,0,0,12"/>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Ändern..." MinWidth="110" Height="32"
                    Click="OnAendern" Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="{Binding HatZeilen}"
                    ToolTip="Für die gewählte Zeile eine andere Möglichkeit wählen (auch: Doppelklick)"/>
            <Button DockPanel.Dock="Right" Content="Abbrechen" MinWidth="110" Height="32" IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"/>
            <Button DockPanel.Dock="Right" Content="Übernehmen" MinWidth="110" Height="32" Margin="0,0,8,0"
                    IsDefault="True" Click="OnUebernehmen"
                    IsEnabled="{Binding IstMoeglich}"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </DockPanel>

        <DataGrid x:Name="Liste" ItemsSource="{Binding Zeilen}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" CanUserSortColumns="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E0E0E0"
                  Background="White" BorderBrush="#D0D0D0"
                  RowHeaderWidth="0"
                  MouseDoubleClick="OnDoppelklick">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="E/Ü-Konto" Width="18*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="4,0,2,0"
                                          IsChecked="{Binding Angehakt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Vorschlag übernehmen"/>
                                <TextBlock Text="{Binding KontoName}" Style="{StaticResource ZellText}"/>
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Art" Binding="{Binding Art}" Width="Auto"
                                    ElementStyle="{StaticResource ZellText}"/>
                <DataGridTextColumn Header="Umsatzsteuer-Voranmeldung" Binding="{Binding UvaText}" Width="21*"
                                    ElementStyle="{StaticResource ZellText}"/>
                <DataGridTextColumn Header="Umsatzsteuererklärung" Binding="{Binding UstText}" Width="21*"
                                    ElementStyle="{StaticResource ZellText}"/>
                <DataGridTextColumn x:Name="BuchungenSpalte" Binding="{Binding BuchungenText}" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ZellText}">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Vorschlag" Binding="{Binding VorschlagText}" Width="40*"
                                    ElementStyle="{StaticResource ZellText}"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <!-- Befund als Tooltip der ganzen Zeile -->
                    <Setter Property="ToolTip" Value="{Binding BefundText}"/>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </DockPanel>
</Window>
