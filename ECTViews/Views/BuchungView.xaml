<Window x:Class="ECTViews.Views.BuchungView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ECTViews.Views"
        Title="{Binding BuchungsartText, StringFormat='Buchung ({0})'}"
        MinWidth="480" MinHeight="640"
        Width="800"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="#F5F5F5"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- app-weite Button-Stile (PrimaryButtonStyle / SecondaryButtonStyle) -->
            <ResourceDictionary Source="/ECTViews;component/GemeinsameStile.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <!-- Basis-Stil für Labels -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>

        <!-- Stil für Fehlertexte: rot, klein, verschwindet bei leerem Text -->
        <Style TargetType="TextBlock" x:Key="ErrorStyle">
            <Setter Property="Foreground" Value="#D32F2F"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stil für Hinweistexte: blau-grau, klein, kursiv. Erkennbar
             abgesetzt von den roten Validierungsfehlern. Wird z.B. zur
             AfA-Restwert-Heuristik verwendet. -->
        <Style TargetType="TextBlock" x:Key="HintStyle">
            <Setter Property="Foreground" Value="#0277BD"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stil für Eingabefelder -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Gruppenbox-Stil -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Konverter: bool → Visibility (Collapsed bei false) -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Konverter: 0 → leeres Feld (Tag/Monat ohne Vorbelegung) -->
        <local:LeereZahlConverter x:Key="LeereZahl"/>

        <!-- PrimaryButtonStyle/SecondaryButtonStyle kommen aus
             GemeinsameStile.xaml (MergedDictionaries oben). -->

        <!-- DataTemplate für Icon-Listen-Items: Icon links, Name rechts.
             Stretch="Uniform" skaliert das gecroppte Icon proportional auf
             die Image-Größe — funktioniert egal ob die Quell-Sprites 16x16,
             32x32 oder andere Größen verwenden. -->
        <DataTemplate x:Key="IconItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Icon}" Width="32" Height="32"
                       Margin="0,0,8,0" Stretch="Uniform"
                       VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Buchungsart -->
            <RowDefinition Height="Auto"/>  <!-- Datum -->
            <RowDefinition Height="Auto"/>  <!-- Betrag + MWSt -->
            <RowDefinition Height="Auto"/>  <!-- Beschreibung -->
            <RowDefinition Height="Auto"/>  <!-- Belegnummer + Konto -->
            <RowDefinition Height="Auto"/>  <!-- Bestandskonto + Betrieb -->
            <RowDefinition Height="Auto"/>  <!-- AfA -->
            <RowDefinition Height="Auto"/>  <!-- Buchungsgruppe -->
            <RowDefinition Height="*"/>     <!-- Spacer -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- ═══ Zeile 0: Buchungsart ═══ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <!-- Farben wie die Abschnittstitel im Journal (ColEinnahme /
                 ColAusgabe in JournalView.xaml): Einnahmen blau, Ausgaben rot. -->
            <RadioButton Content="Einnahme" FontWeight="SemiBold"
                         IsChecked="{Binding IstEinnahme}"
                         Foreground="#1030D0" Margin="0,0,16,0"
                         VerticalContentAlignment="Center"/>
            <RadioButton Content="Ausgabe" FontWeight="SemiBold"
                         IsChecked="{Binding IstAusgabe}"
                         Foreground="#C62828"
                         VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- ═══ Zeile 1: Datum ═══ -->
        <GroupBox Grid.Row="1" Header="Datum">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Tag:" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TagBox"
                             Text="{Binding DatumTag, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LeereZahl}}"
                             Width="40" MaxLength="2" TextAlignment="Center"
                             GotKeyboardFocus="OnFeldGotKeyboardFocus"
                             PreviewMouseLeftButtonDown="OnFeldPreviewMouseLeftButtonDown"/>
                    <TextBlock Text="." VerticalAlignment="Center" Margin="2,0"/>
                    <TextBlock Text="Monat:" Style="{StaticResource LabelStyle}" Margin="8,0,8,0"/>
                    <TextBox Text="{Binding DatumMonat, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LeereZahl}}"
                             Width="40" MaxLength="2" TextAlignment="Center"
                             GotKeyboardFocus="OnFeldGotKeyboardFocus"
                             PreviewMouseLeftButtonDown="OnFeldPreviewMouseLeftButtonDown"/>
                    <TextBlock Text="." VerticalAlignment="Center" Margin="2,0"/>
                    <TextBlock Text="Jahr:" Style="{StaticResource LabelStyle}" Margin="8,0,8,0"/>
                    <TextBox Text="{Binding DatumJahr, UpdateSourceTrigger=PropertyChanged}"
                             Width="60" MaxLength="4" TextAlignment="Center"
                             IsEnabled="{Binding BuchungsjahrFeldAktiviert}"
                             ToolTip="{Binding BuchungsjahrFeldHinweis}"
                             ToolTipService.ShowOnDisabled="True"
                             GotKeyboardFocus="OnFeldGotKeyboardFocus"
                             PreviewMouseLeftButtonDown="OnFeldPreviewMouseLeftButtonDown"/>
                </StackPanel>
                <TextBlock Style="{StaticResource ErrorStyle}"
                           Text="{Binding DatumError}"/>
            </StackPanel>
        </GroupBox>

        <!-- ═══ Zeile 2: Betrag + MWSt ═══ -->
        <GroupBox Grid.Row="2" Header="Betrag">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Bruttobetrag (Label bewusst waehrungsneutral: vor dem
                     Umrechnen steht hier ein Fremdwaehrungsbetrag). -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Brutto:" Style="{StaticResource LabelStyle}"/>
                <DockPanel Grid.Row="0" Grid.Column="1">
                    <!-- Waehrungsrechner: rechnet einen Fremdwaehrungsbetrag ueber
                         den Tageskurs in Euro um (Auswahl aus den Einstellungen). -->
                    <Button DockPanel.Dock="Right" x:Name="WaehrungsrechnerKnopf"
                            Content="{Binding UmrechnenKnopfText}"
                            Margin="6,0,0,0" Padding="8,0" MinWidth="52"
                            Focusable="False"
                            IsEnabled="{Binding NichtAmUmrechnen}"
                            ToolTip="{Binding UmrechnenKnopfTooltip}"
                            Click="OnWaehrungsrechnerKnopf"/>
                    <TextBox x:Name="BetragBox"
                             Text="{Binding BetragText, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Right" FontWeight="SemiBold" FontSize="15"
                             GotKeyboardFocus="OnFeldGotKeyboardFocus"
                             PreviewMouseLeftButtonDown="OnFeldPreviewMouseLeftButtonDown"/>
                </DockPanel>

                <!-- MWSt -->
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="MWSt %:" Style="{StaticResource LabelStyle}" Margin="12,0,8,0"/>
                <ComboBox Grid.Row="0" Grid.Column="4"
                          Text="{Binding MwstText, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding MwstOptionen}"
                          IsEditable="True"
                          IsEnabled="{Binding MwstFeldAktiviert}"
                          ToolTip="{Binding MwstFeldHinweis}"
                          ToolTipService.ShowOnDisabled="True"
                          HorizontalContentAlignment="Right"/>

                <!-- Netto / USt Anzeige -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Netto:" Style="{StaticResource LabelStyle}"
                           Foreground="#888"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding NettoText}" TextAlignment="Right"
                           VerticalAlignment="Center" Foreground="#888" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                           Text="USt:" Style="{StaticResource LabelStyle}"
                           Foreground="#888" Margin="12,0,8,0"/>
                <TextBlock Grid.Row="1" Grid.Column="4"
                           Text="{Binding MwstBetragText}" TextAlignment="Right"
                           VerticalAlignment="Center" Foreground="#888" Margin="0,2"/>

                <!-- Fehler-Zeilen -->
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                           Style="{StaticResource ErrorStyle}"
                           Text="{Binding BetragError}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
                           Style="{StaticResource ErrorStyle}"
                           Text="{Binding MwstError}"/>
            </Grid>
        </GroupBox>

        <!-- ═══ Zeile 3: Beschreibung ═══ -->
        <GroupBox Grid.Row="3" Header="Beschreibung">
            <StackPanel>
                <!-- Echtes TextBox (kein ComboBox): so stoert das Filtern der
                     Vorschlagsliste das Editierfeld/den Cursor NICHT. Der
                     Dropdown-Knopf rechts ersetzt den ComboBox-Pfeil des
                     Originals: er klappt die UNGEFILTERTE Vorlagen-Liste auf. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="BeschreibungBox"
                             Text="{Binding Beschreibung, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="OnBeschreibungLostFocus"
                             GotKeyboardFocus="OnFeldGotKeyboardFocus"
                             PreviewMouseLeftButtonDown="OnFeldPreviewMouseLeftButtonDown"/>
                    <!-- Focusable=False: der Klick darf dem Beschreibungsfeld
                         nicht den Fokus stehlen, sonst schoesse dessen
                         LostFocus-Handler das frisch geoeffnete Popup zu. -->
                    <Button Grid.Column="1" Width="22" Margin="2,2,0,2"
                            Focusable="False"
                            Click="OnVorschlaegeKnopf"
                            ToolTip="{Binding VorschlaegeKnopfTooltip}">
                        <Path Data="M 0 0 L 8 0 L 4 5 Z" Fill="#555"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Vorschlags-Liste (Auto-Complete) als Popup unter dem Feld.
                     Filtert nach Nummer ODER Beschreibungstext. -->
                <Popup PlacementTarget="{Binding ElementName=BeschreibungBox}"
                       Placement="Bottom" StaysOpen="True"
                       IsOpen="{Binding VorschlaegeOffen, Mode=TwoWay}"
                       MinWidth="{Binding ActualWidth, ElementName=BeschreibungBox}">
                    <Border Background="White" BorderBrush="#999999" BorderThickness="1">
                        <ListBox ItemsSource="{Binding PresetVorschlaege}"
                                 DisplayMemberPath="Anzeige"
                                 SelectedItem="{Binding GewaehlterVorschlag, Mode=TwoWay}"
                                 MaxHeight="220"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Border>
                </Popup>

                <TextBlock Style="{StaticResource ErrorStyle}"
                           Text="{Binding BeschreibungError}"/>

                <!-- Balloon: zeigt die Preset-Notiz fuer ein paar Sekunden,
                     wenn ein Preset mit Notiz ausgewaehlt wurde. -->
                <Popup x:Name="NotizBalloon"
                       PlacementTarget="{Binding ElementName=BeschreibungBox}"
                       Placement="Bottom" AllowsTransparency="True"
                       StaysOpen="True" PopupAnimation="Fade"
                       HorizontalOffset="8" VerticalOffset="2">
                    <Border Background="#FFFDE7" BorderBrush="#E0C46C" BorderThickness="1"
                            CornerRadius="3" Padding="10,7" MaxWidth="360"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#888888" BlurRadius="8"
                                              ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#128161;" FontSize="14" Margin="0,0,8,0"
                                       VerticalAlignment="Top"/>
                            <TextBlock x:Name="NotizText" TextWrapping="Wrap"
                                       Foreground="#5D4A00"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </GroupBox>

        <!-- ═══ Zeile 4: Belegnummer + Konto ═══ -->
        <GroupBox Grid.Row="4" Header="Zuordnung">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Beleg-Nr.:"
                           Style="{StaticResource LabelStyle}"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Belegnummer, UpdateSourceTrigger=PropertyChanged}"
                         GotKeyboardFocus="OnFeldGotKeyboardFocus"
                         PreviewMouseLeftButtonDown="OnFeldPreviewMouseLeftButtonDown"/>
                <TextBlock Grid.Column="2" Text="Konto:"
                           Style="{StaticResource LabelStyle}" Margin="12,0,8,0"/>
                <ComboBox Grid.Column="3"
                          SelectedItem="{Binding SelectedKonto, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Konten}"/>
            </Grid>
        </GroupBox>

        <!-- ═══ Zeile 5: Bestandskonto + Betrieb (mit Icon-Listen) ═══ -->
        <Grid Grid.Row="5"
              Visibility="{Binding ListenAnzeigen, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Bestandskonto"
                      Visibility="{Binding BestandskontenAnzeigen,
                                   Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <local:ListBoxScroll ItemsSource="{Binding Bestandskonten}"
                                   SelectedItem="{Binding SelectedBestandskonto}"
                                   ItemTemplate="{StaticResource IconItemTemplate}"
                                   Height="160"
                                   ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Style="{StaticResource ErrorStyle}"
                               Text="{Binding BestandskontoError}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Betrieb"
                      Visibility="{Binding BetriebeAnzeigen,
                                   Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ListBox ItemsSource="{Binding Betriebe}"
                             SelectedItem="{Binding SelectedBetrieb}"
                             ItemTemplate="{StaticResource IconItemTemplate}"
                             Height="160"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Style="{StaticResource ErrorStyle}"
                               Text="{Binding BetriebError}"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- ═══ Zeile 6: Abschreibung ═══ -->
        <!-- Nur bei Ausgaben bedienbar (Einnahmen kennen keine AfA; das
             MFC-Original versteckt die Controls dort komplett). -->
        <GroupBox Grid.Row="6" Header="Abschreibung (AfA)"
                  IsEnabled="{Binding IstAusgabe}"
                  ToolTip="{Binding AfaFeldHinweis}"
                  ToolTipService.ShowOnDisabled="True">
            <StackPanel>
                <CheckBox Content="Abschreibung aktivieren"
                          IsChecked="{Binding AfaAktiviert}"
                          Margin="0,0,0,6"/>
                <Grid IsEnabled="{Binding AfaAktiviert}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Jahre:"
                               Style="{StaticResource LabelStyle}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              Text="{Binding AfaJahre}"
                              ItemsSource="{Binding AfaJahreOptionen}"
                              IsEditable="True"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Nr.:"
                               Style="{StaticResource LabelStyle}" Margin="12,0,8,0"/>
                    <TextBox Grid.Row="0" Grid.Column="3"
                             Text="{Binding AfaNr}" TextAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Restwert:"
                               Style="{StaticResource LabelStyle}" Margin="12,0,8,0"/>
                    <TextBox Grid.Row="0" Grid.Column="5"
                             Text="{Binding AfaRestwertText, UpdateSourceTrigger=LostFocus}"
                             TextAlignment="Right"/>

                    <!-- [Abgang buchen]: nur bei bestehender, mehrjaehriger AfA mit Restwert -->
                    <Button Grid.Row="0" Grid.Column="6"
                            Content="Abgang buchen"
                            Command="{Binding AbgangBuchenCommand}"
                            Visibility="{Binding AbgangButtonSichtbar, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="12,0,0,0" Padding="10,2"/>

                    <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                              Content="Degressiv"
                              IsChecked="{Binding AfaDegressiv}" Margin="0,4,0,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Satz %:"
                               Style="{StaticResource LabelStyle}" Margin="12,0,8,0"/>
                    <TextBox Grid.Row="1" Grid.Column="3"
                             Text="{Binding AfaSatz}" TextAlignment="Center"
                             IsEnabled="{Binding AfaDegressiv}"/>
                </Grid>
                <TextBlock Style="{StaticResource ErrorStyle}"
                           Text="{Binding AfaError}"/>
                <TextBlock Style="{StaticResource HintStyle}"
                           Text="{Binding AfaHinweis}"/>
            </StackPanel>
        </GroupBox>

        <!-- ═══ Zeile 7: Buchungsgruppen-Zeilen (nur bei mehrzeiliger Vorlage) ═══ -->
        <GroupBox Grid.Row="7" Margin="0,8,0,0" Padding="8"
                  Visibility="{Binding HatZusatzzeilen, Converter={StaticResource BoolToVis}}">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Buchungsgruppe: "/>
                    <TextBlock Text="{Binding GruppenVorlageName}" FontWeight="SemiBold"/>
                </StackPanel>
            </GroupBox.Header>
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Zusatzzeilen}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Visibility="{Binding IstSichtbar, Converter={StaticResource BoolToVis}}"
                                    BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,4">
                                <StackPanel>
                                    <!-- [kompakte (additive) Darstellung: nur die Eingabefelder] -->
                                    <Grid Visibility="{Binding IstKompakt, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding KontoText}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding BeschreibungText}" Foreground="#777"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding BeschreibungText}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Betrag:" VerticalAlignment="Center"
                                                   Margin="8,0,4,0" Foreground="#333"/>
                                        <Grid Grid.Column="2" Width="90">
                                            <TextBox Text="{Binding BetragText, UpdateSourceTrigger=PropertyChanged}"
                                                     TextAlignment="Right"
                                                     Visibility="{Binding BetragEditierbar, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding BetragAnzeige}" TextAlignment="Right"
                                                       VerticalAlignment="Center" Foreground="#555"
                                                       ToolTip="{Binding BetragFormelTooltip}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BetragEditierbar}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Grid.Column="3" Text="MWSt %:" VerticalAlignment="Center"
                                                   Margin="10,0,4,0" Foreground="#333"/>
                                        <Grid Grid.Column="4" Width="50">
                                            <TextBox Text="{Binding MwstText, UpdateSourceTrigger=PropertyChanged}"
                                                     TextAlignment="Center"
                                                     Visibility="{Binding MwstEditierbar, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding MwstAnzeige}" TextAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="#555"
                                                       ToolTip="{Binding MwstTooltip}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MwstEditierbar}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Grid>

                                    <!-- [Masken-Darstellung (subtraktiv): alle aufgelösten Felder,
                                         berechnete readonly] -->
                                    <Grid Visibility="{Binding IstMaske, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Konto:" Foreground="#333" Margin="0,0,8,2"/>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding KontoText}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ArtText, StringFormat=' ({0})'}" Foreground="#777"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Beschreibung:" Foreground="#333" Margin="0,0,8,2"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BeschreibungText}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Beleg:" Foreground="#333" Margin="0,0,8,2"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BelegText}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Betrag / MWSt:" Foreground="#333" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                            <Grid Width="90">
                                                <TextBox Text="{Binding BetragText, UpdateSourceTrigger=PropertyChanged}"
                                                         TextAlignment="Right"
                                                         Visibility="{Binding BetragEditierbar, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding BetragAnzeige}" TextAlignment="Right"
                                                           VerticalAlignment="Center" Foreground="#555"
                                                           ToolTip="{Binding BetragFormelTooltip}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BetragEditierbar}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <Grid Width="50" Margin="10,0,0,0">
                                                <TextBox Text="{Binding MwstText, UpdateSourceTrigger=PropertyChanged}"
                                                         TextAlignment="Center"
                                                         Visibility="{Binding MwstEditierbar, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding MwstAnzeige}" TextAlignment="Center"
                                                           VerticalAlignment="Center" Foreground="#555"
                                                           ToolTip="{Binding MwstTooltip}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MwstEditierbar}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#777"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Style="{StaticResource ErrorStyle}"
                                               Text="{Binding ZeilenFehler}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- [Summenzeile + Vorlage entfernen] -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding GruppenSummeText}" Foreground="#333"/>
                        <TextBlock Style="{StaticResource ErrorStyle}"
                                   Text="{Binding GruppenFehlerText}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Vorlage entfernen" Padding="8,2"
                            VerticalAlignment="Top"
                            Command="{Binding GruppeEntfernenCommand}"
                            ToolTip="Zusatz-Zeilen verwerfen und nur die Basis-Buchung buchen"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- ═══ Zeile 9: Buttons ═══ -->
        <StackPanel Grid.Row="9" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{Binding OkButtonText}"
                    Command="{Binding OkCommand}"
                    Width="100" Height="32"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,8,0"/>
            <Button Content="Weiterbuchen"
                    Command="{Binding WeiterbuchenCommand}"
                    Width="110" Height="32"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Visibility="{Binding WeiterbuchenSichtbar, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,8,0"/>
            <Button Content="Abbrechen"
                    Command="{Binding AbbrechenCommand}"
                    Width="100" Height="32"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>

        <!-- Fortschritts-Overlay des Waehrungsrechners ueber Betrag (Zeile 2)
             und Beschreibung (Zeile 3): waehrend der asynchronen Kursabfrage
             sichtbar, mit Abbrechen-Moeglichkeit. Als letztes Grid-Kind = liegt
             optisch oben (Issue #21: keine einfrierende/haengende Oberflaeche). -->
        <Border Grid.Row="2" Grid.RowSpan="2" Panel.ZIndex="100"
                Background="#D8FFFFFF" CornerRadius="3"
                Visibility="{Binding UmrechnungLaeuft, Converter={StaticResource BoolToVis}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" BorderBrush="#1565C0" BorderThickness="1"
                    CornerRadius="4" Padding="16,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="130" Height="14"
                                 VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding UmrechnungStatus}" Margin="12,0,12,0"
                               VerticalAlignment="Center" Foreground="#333"/>
                    <Button Content="Abbrechen" Padding="10,3" Focusable="False"
                            Command="{Binding AbbrechenUmrechnungCommand}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
