<Window x:Class="ECTViews.Views.BuchungView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ECTViews.Views"
        Title="{Binding BuchungsartText, StringFormat='Buchung ({0})'}"
        MinWidth="480" MinHeight="640"
        Width="800"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="#F5F5F5"
        FontFamily="Segoe UI" FontSize="13">

    <!-- Aufbau: oben der SCROLLBEREICH mit allen Eingabe-Boxen, darunter
         fest die Buchen-/Abbrechen-Knoepfe. Das Fenster waechst mit seinem
         Inhalt (SizeToContent=Height), hoechstens bis zur Hoehe des
         Arbeitsbereichs (MaxHeight setzt das Code-Behind) - erst dann
         erscheint der Scrollbalken. Noetig, weil eine Buchungsvorlage den
         Dialog um Zusatz-Felder erweitern kann. -->

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- app-weite Button-Stile (PrimaryButtonStyle / SecondaryButtonStyle) -->
            <ResourceDictionary Source="/ECTViews;component/GemeinsameStile.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <!-- Konverter: bool nach Visibility (Collapsed bei false). Steht
             ganz oben, weil WPF Resources der Reihe nach liest und die
             Templates weiter unten ihn per StaticResource brauchen. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Basis-Stil für Labels -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>

        <!-- Stil für Fehlertexte: rot, klein, verschwindet bei leerem Text -->
        <Style TargetType="TextBlock" x:Key="ErrorStyle">
            <Setter Property="Foreground" Value="#D32F2F"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <!-- Blinken nach wiederholtem Buchen-Versuch: das Code-Behind
                     schaltet BuchungView.FehlerFett hin und her. Ueber das
                     Fenster gebunden, weil der Stil auch in Templates mit
                     anderem DataContext steckt (Zusatz-Felder, Vorschau-Zeilen). -->
                <DataTrigger Binding="{Binding FehlerFett, RelativeSource={RelativeSource AncestorType=local:BuchungView}}"
                             Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Stil für Hinweistexte: blau-grau, klein, kursiv. Erkennbar
             abgesetzt von den roten Validierungsfehlern. Wird z.B. zur
             AfA-Restwert-Heuristik verwendet. -->
        <Style TargetType="TextBlock" x:Key="HintStyle">
            <Setter Property="Foreground" Value="#0277BD"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stil für Vorschau-/Nebentexte: grau, klein. Für das, was die
             aktive Buchungsvorlage aus den Eingaben macht (gebuchte
             Beschreibung, uebersprungene Zusatz-Zeile). -->
        <Style TargetType="TextBlock" x:Key="VorschauStyle">
            <Setter Property="Foreground" Value="#777"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stil für Eingabefelder -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Gruppenbox-Stil -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- PrimaryButtonStyle/SecondaryButtonStyle kommen aus
             GemeinsameStile.xaml (MergedDictionaries oben). -->

        <!-- DataTemplate für Icon-Listen-Items: Icon links, Name rechts.
             Stretch="Uniform" skaliert das gecroppte Icon proportional auf
             die Image-Größe; funktioniert egal ob die Quell-Sprites 16x16,
             32x32 oder andere Größen verwenden. -->
        <DataTemplate x:Key="IconItemTemplate">
            <!-- LastChildFill=False + rechts angedocktes Kuerzel-Schild: so
                 verschiebt das Ein-/Ausblenden des Hinweises Icon und Name
                 nicht. Braucht HorizontalContentAlignment=Stretch an der
                 ListBox, sonst ist die Zeile nur so breit wie ihr Inhalt. -->
            <DockPanel LastChildFill="False">
                <Image DockPanel.Dock="Left" Source="{Binding Icon}"
                       Width="32" Height="32"
                       Margin="0,0,8,0" Stretch="Uniform"
                       VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}"
                           VerticalAlignment="Center" FontSize="13"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Kuerzel-Schild: nur sichtbar, solange Alt gedrueckt ist
                     (BuchungViewModel.AltHinweiseSichtbar) und der Eintrag
                     ueberhaupt ein Kuerzel hat (die ersten zehn der beiden
                     Original-Listen; Zusatz-Feld-Listen haben keine). -->
                <Border x:Name="HotkeySchild" DockPanel.Dock="Right"
                        Visibility="Collapsed"
                        Background="#FFF3C4" BorderBrush="#D4A72C"
                        BorderThickness="1" CornerRadius="3"
                        Padding="4,0" Margin="8,0,2,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Hotkey}" FontSize="11"
                               Foreground="#5D4A00"/>
                </Border>
            </DockPanel>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HatHotkey}" Value="True"/>
                        <Condition Binding="{Binding DataContext.AltHinweiseSichtbar,
                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                   Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="HotkeySchild" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- [Zusatz-Felder der Buchungsvorlage]
             Ein Template pro Control-Art (ZusatzFeldViewModel.Steuerelement);
             der ZusatzFeldSelektor waehlt aus. Die Beschriftungen einer Box
             stehen ueber SharedSizeGroup buendig untereinander. -->

        <!-- Textfeld ueber die volle Breite -->
        <DataTemplate x:Key="ZusatzFeldText">
            <StackPanel Margin="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ZusatzFeldLabel"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Beschriftung}" ToolTip="{Binding Hinweis}"
                               Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             GotKeyboardFocus="OnFeldGotKeyboardFocus"
                             PreviewMouseLeftButtonDown="OnFeldPreviewMouseLeftButtonDown"/>
                </Grid>
                <TextBlock Style="{StaticResource ErrorStyle}" Text="{Binding Fehler}"/>
            </StackPanel>
        </DataTemplate>

        <!-- schmales, rechtsbuendiges Feld mit Einheit (Betrag, Zahl,
             Prozent, Datum) -->
        <DataTemplate x:Key="ZusatzFeldZahl">
            <StackPanel Margin="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ZusatzFeldLabel"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Beschriftung}" ToolTip="{Binding Hinweis}"
                               Style="{StaticResource LabelStyle}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="120" TextAlignment="Right"
                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                 GotKeyboardFocus="OnFeldGotKeyboardFocus"
                                 PreviewMouseLeftButtonDown="OnFeldPreviewMouseLeftButtonDown"/>
                        <TextBlock Text="{Binding Einheit}" VerticalAlignment="Center"
                                   Margin="4,0,0,0" Foreground="#777"/>
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource ErrorStyle}" Text="{Binding Fehler}"/>
            </StackPanel>
        </DataTemplate>

        <!-- MWSt-Satz: editierbare Auswahl wie das Original-Feld -->
        <DataTemplate x:Key="ZusatzFeldMwst">
            <StackPanel Margin="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ZusatzFeldLabel"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Beschriftung}" ToolTip="{Binding Hinweis}"
                               Style="{StaticResource LabelStyle}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ComboBox Width="80" IsEditable="True"
                                  Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding Optionen}"
                                  HorizontalContentAlignment="Right"/>
                        <TextBlock Text="{Binding Einheit}" VerticalAlignment="Center"
                                   Margin="4,0,0,0" Foreground="#777"/>
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource ErrorStyle}" Text="{Binding Fehler}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Auswahlliste (Auswahl-Feld, Konto) -->
        <DataTemplate x:Key="ZusatzFeldAuswahl">
            <StackPanel Margin="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ZusatzFeldLabel"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Beschriftung}" ToolTip="{Binding Hinweis}"
                               Style="{StaticResource LabelStyle}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Optionen}"
                              SelectedItem="{Binding GewaehlteOption}"/>
                </Grid>
                <TextBlock Style="{StaticResource ErrorStyle}" Text="{Binding Fehler}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Haekchen -->
        <DataTemplate x:Key="ZusatzFeldHaekchen">
            <CheckBox Margin="0,6,0,2" Content="{Binding Bezeichnung}"
                      IsChecked="{Binding IstAngehakt}" ToolTip="{Binding Hinweis}"/>
        </DataTemplate>

        <!-- Icon-Liste (Betrieb, Bestandskonto) wie die Original-Listen -->
        <DataTemplate x:Key="ZusatzFeldIconListe">
            <StackPanel Margin="0,6,0,0"
                        Visibility="{Binding Sichtbar, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Beschriftung}" ToolTip="{Binding Hinweis}"
                           Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                <local:ListBoxScroll ItemsSource="{Binding Eintraege}"
                                     SelectedItem="{Binding GewaehlterEintrag}"
                                     ItemTemplate="{StaticResource IconItemTemplate}"
                                     Height="120"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                <TextBlock Style="{StaticResource ErrorStyle}" Text="{Binding Fehler}"/>
            </StackPanel>
        </DataTemplate>

        <local:ZusatzFeldTemplateSelector x:Key="ZusatzFeldSelektor"
            Text="{StaticResource ZusatzFeldText}"
            Zahl="{StaticResource ZusatzFeldZahl}"
            Mwst="{StaticResource ZusatzFeldMwst}"
            Auswahl="{StaticResource ZusatzFeldAuswahl}"
            Haekchen="{StaticResource ZusatzFeldHaekchen}"
            IconListe="{StaticResource ZusatzFeldIconListe}"/>

        <!-- Liste der Zusatz-Felder einer Box; ohne Felder nimmt sie
             keinen Platz ein. -->
        <Style x:Key="ZusatzFelderListe" TargetType="ItemsControl">
            <Setter Property="ItemTemplateSelector" Value="{StaticResource ZusatzFeldSelektor}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Style.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>     <!-- Scrollbereich mit den Eingabe-Boxen -->
            <RowDefinition Height="Auto"/>  <!-- Fehler ausgeblendeter Felder -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Focusable=False: der Scrollbereich selbst soll kein Tabstopp
             sein. Beim Scrollen schliesst das Code-Behind die Popups
             (Vorlagen-Liste, Notiz), die sonst an alter Stelle stehen
             blieben. -->
        <ScrollViewer x:Name="FelderScroll" Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      ScrollChanged="OnFelderScrollChanged"
                      PreviewMouseWheel="OnFelderPreviewMouseWheel">
        <Grid VerticalAlignment="Top" Margin="0,0,2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0 Buchungsart -->
            <RowDefinition Height="Auto"/>  <!-- 1 Hinweis zur Vorlage -->
            <RowDefinition Height="Auto"/>  <!-- 2 Datum -->
            <RowDefinition Height="Auto"/>  <!-- 3 Beschreibung -->
            <RowDefinition Height="Auto"/>  <!-- 4 Betrag + MWSt -->
            <RowDefinition Height="Auto"/>  <!-- 5 Belegnummer + Konto -->
            <RowDefinition Height="Auto"/>  <!-- 6 Bestandskonto + Betrieb -->
            <RowDefinition Height="Auto"/>  <!-- 7 AfA -->
            <RowDefinition Height="Auto"/>  <!-- 8 aktive Buchungsvorlage -->
        </Grid.RowDefinitions>

        <!-- [Zeile 0: Buchungsart] -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <!-- Farben wie die Abschnittstitel im Journal (ColEinnahme /
                 ColAusgabe in JournalView.xaml): Einnahmen blau, Ausgaben rot. -->
            <RadioButton Content="Einnahme" FontWeight="SemiBold"
                         IsChecked="{Binding IstEinnahme}"
                         Foreground="#1030D0" Margin="0,0,16,0"
                         VerticalContentAlignment="Center"/>
            <RadioButton Content="Ausgabe" FontWeight="SemiBold"
                         IsChecked="{Binding IstAusgabe}"
                         Foreground="#C62828"
                         VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- [Zeile 1: Hinweis, z.B. wenn die Buchung nicht mehr mit ihrer
             Vorlage geoeffnet werden konnte] -->
        <TextBlock Grid.Row="1" Style="{StaticResource HintStyle}"
                   Margin="0,0,0,6" Text="{Binding VorlagenHinweis}"/>

        <!-- [Zeile 2: Datum] -->
        <GroupBox Grid.Row="2" Header="Datum">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Tag:" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TagBox"
                             Text="{Binding DatumTagText, UpdateSourceTrigger=PropertyChanged}"
                             Width="40" MaxLength="2" TextAlignment="Center"
                             GotKeyboardFocus="OnFeldGotKeyboardFocus"
                             TextChanged="OnDatumTagTextChanged"
                             PreviewMouseLeftButtonDown="OnFeldPreviewMouseLeftButtonDown"/>
                    <TextBlock Text="." VerticalAlignment="Center" Margin="2,0"/>
                    <TextBlock Text="Monat:" Style="{StaticResource LabelStyle}" Margin="8,0,8,0"/>
                    <TextBox x:Name="MonatBox"
                             Text="{Binding DatumMonatText, UpdateSourceTrigger=PropertyChanged}"
                             Width="40" MaxLength="2" TextAlignment="Center"
                             GotKeyboardFocus="OnFeldGotKeyboardFocus"
                             TextChanged="OnDatumMonatTextChanged"
                             PreviewMouseLeftButtonDown="OnFeldPreviewMouseLeftButtonDown"/>
                    <TextBlock Text="." VerticalAlignment="Center" Margin="2,0"/>
                    <TextBlock Text="Jahr:" Style="{StaticResource LabelStyle}" Margin="8,0,8,0"/>
                    <TextBox x:Name="JahrBox"
                             Text="{Binding DatumJahrText, UpdateSourceTrigger=PropertyChanged}"
                             Width="60" MaxLength="4" TextAlignment="Center"
                             IsEnabled="{Binding BuchungsjahrFeldAktiviert}"
                             ToolTip="{Binding BuchungsjahrFeldHinweis}"
                             ToolTipService.ShowOnDisabled="True"
                             GotKeyboardFocus="OnFeldGotKeyboardFocus"
                             TextChanged="OnDatumJahrTextChanged"
                             PreviewMouseLeftButtonDown="OnFeldPreviewMouseLeftButtonDown"/>
                    <!-- Haekchen direkt am Jahresfeld (Pendant zu
                         IDC_JAHR_ENABLED im MFC-Original): schaltet das
                         Jahresfeld frei und merkt sich das global in den
                         Einstellungen.
                         IsTabStop=False: die Checkbox steht mitten im
                         Eingabefluss, soll ihn aber nicht aufhalten. Per
                         Tastatur bleibt sie ueber ihr Kuerzel Alt+N
                         erreichbar (das "n" in "aenderbar"). -->
                    <CheckBox Content="ä_nderbar" Margin="8,0,0,0"
                              VerticalAlignment="Center" IsTabStop="False"
                              IsChecked="{Binding BuchungsjahrFeldAktiviert, Mode=TwoWay}"
                              ToolTip="Buchungsjahr-Feld zum Bearbeiten freigeben (Alt+N; Einstellung gilt dauerhaft, wie Einstellungen -> Allgemein)"/>
                </StackPanel>
                <TextBlock Style="{StaticResource ErrorStyle}"
                           Text="{Binding DatumError}"/>
                <ItemsControl ItemsSource="{Binding FelderDatum}"
                              Style="{StaticResource ZusatzFelderListe}"/>
            </StackPanel>
        </GroupBox>

        <!-- [Zeile 3: Beschreibung] -->
        <GroupBox Grid.Row="3" Header="{Binding FeldBeschreibung.Titel}">
            <StackPanel>
                <!-- Echtes TextBox (kein ComboBox): so stoert das Filtern der
                     Vorschlagsliste das Editierfeld/den Cursor NICHT. Der
                     Dropdown-Knopf rechts ersetzt den ComboBox-Pfeil des
                     Originals: er klappt die UNGEFILTERTE Vorlagen-Liste auf. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="BeschreibungBox"
                             Text="{Binding Beschreibung, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="OnBeschreibungLostFocus"
                             PreviewKeyDown="OnBeschreibungPreviewKeyDown"
                             GotKeyboardFocus="OnFeldGotKeyboardFocus"
                             PreviewMouseLeftButtonDown="OnFeldPreviewMouseLeftButtonDown"/>
                    <!-- Focusable=False: der Klick darf dem Beschreibungsfeld
                         nicht den Fokus stehlen, sonst schoesse dessen
                         LostFocus-Handler das frisch geoeffnete Popup zu. -->
                    <Button Grid.Column="1" x:Name="VorschlaegeKnopf"
                            Width="22" Margin="2,2,0,2"
                            Focusable="False"
                            Click="OnVorschlaegeKnopf"
                            ToolTip="{Binding VorschlaegeKnopfTooltip}">
                        <Path Data="M 0 0 L 8 0 L 4 5 Z" Fill="#555"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Vorschlags-Liste (Auto-Complete) als Popup unter dem Feld.
                     Filtert nach Nummer ODER Beschreibungstext. -->
                <Popup x:Name="VorschlagPopup"
                       PlacementTarget="{Binding ElementName=BeschreibungBox}"
                       Placement="Bottom" StaysOpen="True"
                       IsOpen="{Binding VorschlaegeOffen, Mode=TwoWay}"
                       MinWidth="{Binding ActualWidth, ElementName=BeschreibungBox}">
                    <Border Background="White" BorderBrush="#999999" BorderThickness="1">
                        <!-- KEINE SelectedItem-Bindung: die Markierung ist nur
                             Hervorhebung (Pfeiltasten aus dem Beschreibungsfeld),
                             uebernommen wird per Klick oder Enter (Code-Behind).
                             Focusable=False: der Fokus bleibt im Feld. -->
                        <ListBox x:Name="VorschlagListe"
                                 ItemsSource="{Binding PresetVorschlaege}"
                                 DisplayMemberPath="Anzeige"
                                 Focusable="False"
                                 PreviewMouseLeftButtonDown="OnVorschlagAngeklickt"
                                 MaxHeight="220"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Border>
                </Popup>

                <TextBlock Style="{StaticResource ErrorStyle}"
                           Text="{Binding BeschreibungError}"/>

                <!-- Vorschau: setzt die aktive Vorlage die gebuchte
                     Beschreibung aus einem Template zusammen, steht hier das
                     Ergebnis (das Feld selbst behaelt den getippten Text). -->
                <TextBlock Style="{StaticResource VorschauStyle}"
                           Text="{Binding BeschreibungVorschau}"/>

                <ItemsControl ItemsSource="{Binding FelderBeschreibung}"
                              Style="{StaticResource ZusatzFelderListe}"/>

                <!-- Balloon: zeigt die Preset-Notiz fuer ein paar Sekunden,
                     wenn ein Preset mit Notiz ausgewaehlt wurde. -->
                <Popup x:Name="NotizBalloon"
                       PlacementTarget="{Binding ElementName=BeschreibungBox}"
                       Placement="Bottom" AllowsTransparency="True"
                       StaysOpen="True" PopupAnimation="Fade"
                       HorizontalOffset="8" VerticalOffset="2">
                    <Border Background="#FFFDE7" BorderBrush="#E0C46C" BorderThickness="1"
                            CornerRadius="3" Padding="10,7" MaxWidth="360"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#888888" BlurRadius="8"
                                              ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#128161;" FontSize="14" Margin="0,0,8,0"
                                       VerticalAlignment="Top"/>
                            <TextBlock x:Name="NotizText" TextWrapping="Wrap"
                                       Foreground="#5D4A00"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </GroupBox>

        <!-- [Zeile 4: Betrag + MWSt]
             Beide Felder kann die aktive Vorlage sperren, ausblenden oder
             umbenennen (FeldBetrag / FeldMwst). -->
        <GroupBox Grid.Row="4" Header="Betrag"
                  Visibility="{Binding BetragBoxSichtbar, Converter={StaticResource BoolToVis}}">
            <StackPanel>
            <Grid Visibility="{Binding BetragZeileSichtbar, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Auto statt fester Breite: blendet die Vorlage die MWSt
                         aus, gibt die Spalte ihren Platz an den Betrag ab. -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Bruttobetrag (Label bewusst waehrungsneutral: vor dem
                     Umrechnen steht hier ein Fremdwaehrungsbetrag). -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding FeldBetrag.Beschriftung}"
                           Style="{StaticResource LabelStyle}"
                           Visibility="{Binding FeldBetrag.Sichtbar, Converter={StaticResource BoolToVis}}"/>
                <!-- IsEnabled am DockPanel: eine gesperrte Vorlage sperrt
                     Feld UND Waehrungsrechner; der Betrag kommt dann aus der
                     Formel der Vorlage. -->
                <DockPanel Grid.Row="0" Grid.Column="1"
                           Visibility="{Binding FeldBetrag.Sichtbar, Converter={StaticResource BoolToVis}}"
                           IsEnabled="{Binding FeldBetrag.Aktiv}"
                           ToolTip="{Binding FeldBetrag.SperrHinweis}"
                           ToolTipService.ShowOnDisabled="True">
                    <!-- Waehrungsrechner: rechnet einen Fremdwaehrungsbetrag ueber
                         den Tageskurs in Euro um (Auswahl aus den Einstellungen). -->
                    <Button DockPanel.Dock="Right" x:Name="WaehrungsrechnerKnopf"
                            Content="{Binding UmrechnenKnopfText}"
                            Margin="6,0,0,0" Padding="8,0" MinWidth="52"
                            Focusable="False"
                            IsEnabled="{Binding NichtAmUmrechnen}"
                            ToolTip="{Binding UmrechnenKnopfTooltip}"
                            Click="OnWaehrungsrechnerKnopf"/>
                    <TextBox x:Name="BetragBox"
                             Text="{Binding BetragText, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Right" FontWeight="SemiBold" FontSize="15"
                             GotKeyboardFocus="OnFeldGotKeyboardFocus"
                             PreviewMouseLeftButtonDown="OnFeldPreviewMouseLeftButtonDown"/>
                </DockPanel>

                <!-- MWSt -->
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="{Binding FeldMwst.Beschriftung}"
                           Style="{StaticResource LabelStyle}" Margin="12,0,8,0"
                           Visibility="{Binding FeldMwst.Sichtbar, Converter={StaticResource BoolToVis}}"/>
                <ComboBox Grid.Row="0" Grid.Column="4" Width="80"
                          Text="{Binding MwstText, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding MwstOptionen}"
                          IsEditable="True"
                          Visibility="{Binding FeldMwst.Sichtbar, Converter={StaticResource BoolToVis}}"
                          IsEnabled="{Binding MwstEingabeAktiv}"
                          ToolTip="{Binding MwstEingabeHinweis}"
                          ToolTipService.ShowOnDisabled="True"
                          HorizontalContentAlignment="Right"/>

                <!-- Netto / USt Anzeige: nur solange die MWSt zu sehen ist.
                     Blendet die Vorlage sie aus (Umbuchung, Pauschalen),
                     gibt es auch nichts aufzuschluesseln. -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Netto:" Style="{StaticResource LabelStyle}"
                           Foreground="#888"
                           Visibility="{Binding FeldMwst.Sichtbar, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding NettoText}" TextAlignment="Right"
                           VerticalAlignment="Center" Foreground="#888" Margin="0,2"
                           Visibility="{Binding FeldMwst.Sichtbar, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                           Text="USt:" Style="{StaticResource LabelStyle}"
                           Foreground="#888" Margin="12,0,8,0"
                           Visibility="{Binding FeldMwst.Sichtbar, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Grid.Row="1" Grid.Column="4"
                           Text="{Binding MwstBetragText}" TextAlignment="Right"
                           VerticalAlignment="Center" Foreground="#888" Margin="0,2"
                           Visibility="{Binding FeldMwst.Sichtbar, Converter={StaticResource BoolToVis}}"/>

                <!-- Fehler-Zeilen -->
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                           Style="{StaticResource ErrorStyle}"
                           Text="{Binding BetragError}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
                           Style="{StaticResource ErrorStyle}"
                           Text="{Binding MwstError}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding FelderBetrag}"
                          Style="{StaticResource ZusatzFelderListe}"/>
            </StackPanel>
        </GroupBox>

        <!-- [Zeile 5: Belegnummer + Konto] -->
        <GroupBox Grid.Row="5" Header="Zuordnung"
                  Visibility="{Binding ZuordnungBoxSichtbar, Converter={StaticResource BoolToVis}}">
            <StackPanel>
            <!-- Spalten "Auto" + feste Feldbreite: ein ausgeblendetes
                 Beleg-Feld gibt seinen Platz an das Konto ab. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding FeldBeleg.Beschriftung}"
                           Style="{StaticResource LabelStyle}"
                           Visibility="{Binding FeldBeleg.Sichtbar, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Column="1" Width="120" Margin="0,2,12,2"
                         Text="{Binding Belegnummer, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding FeldBeleg.Sichtbar, Converter={StaticResource BoolToVis}}"
                         IsEnabled="{Binding FeldBeleg.Aktiv}"
                         ToolTip="{Binding FeldBeleg.SperrHinweis}"
                         ToolTipService.ShowOnDisabled="True"
                         GotKeyboardFocus="OnFeldGotKeyboardFocus"
                         PreviewMouseLeftButtonDown="OnFeldPreviewMouseLeftButtonDown"/>
                <TextBlock Grid.Column="2" Text="{Binding FeldKonto.Beschriftung}"
                           Style="{StaticResource LabelStyle}"
                           Visibility="{Binding FeldKonto.Sichtbar, Converter={StaticResource BoolToVis}}"/>
                <ComboBox Grid.Column="3"
                          SelectedItem="{Binding SelectedKonto, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Konten}"
                          Visibility="{Binding FeldKonto.Sichtbar, Converter={StaticResource BoolToVis}}"
                          IsEnabled="{Binding FeldKonto.Aktiv}"
                          ToolTip="{Binding FeldKonto.SperrHinweis}"
                          ToolTipService.ShowOnDisabled="True"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding FelderZuordnung}"
                          Style="{StaticResource ZusatzFelderListe}"/>
            </StackPanel>
        </GroupBox>

        <!-- [Zeile 6: Bestandskonto + Betrieb (mit Icon-Listen)]
             Eine Box erscheint, wenn ihre Original-Liste etwas zu zeigen
             hat ODER die Vorlage ein Zusatz-Feld hineinlegt. -->
        <Grid Grid.Row="6"
              Visibility="{Binding ListenBereichSichtbar, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="{Binding FeldBestandskonto.Titel}"
                      Visibility="{Binding BestandskontoBoxSichtbar,
                                   Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Visibility="{Binding BestandskontoListeSichtbar,
                                             Converter={StaticResource BoolToVis}}">
                        <local:ListBoxScroll ItemsSource="{Binding Bestandskonten}"
                                       SelectedItem="{Binding SelectedBestandskonto}"
                                       ItemTemplate="{StaticResource IconItemTemplate}"
                                       Height="160"
                                       HorizontalContentAlignment="Stretch"
                                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                                       IsEnabled="{Binding FeldBestandskonto.Aktiv}"
                                       ToolTip="{Binding FeldBestandskonto.SperrHinweis}"
                                       ToolTipService.ShowOnDisabled="True"/>
                        <TextBlock Style="{StaticResource ErrorStyle}"
                                   Text="{Binding BestandskontoError}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding FelderBestandskonto}"
                                  Style="{StaticResource ZusatzFelderListe}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="{Binding FeldBetrieb.Titel}"
                      Visibility="{Binding BetriebBoxSichtbar,
                                   Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Visibility="{Binding BetriebListeSichtbar,
                                             Converter={StaticResource BoolToVis}}">
                        <ListBox ItemsSource="{Binding Betriebe}"
                                 SelectedItem="{Binding SelectedBetrieb}"
                                 ItemTemplate="{StaticResource IconItemTemplate}"
                                 Height="160"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 IsEnabled="{Binding FeldBetrieb.Aktiv}"
                                 ToolTip="{Binding FeldBetrieb.SperrHinweis}"
                                 ToolTipService.ShowOnDisabled="True"/>
                        <TextBlock Style="{StaticResource ErrorStyle}"
                                   Text="{Binding BetriebError}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding FelderBetrieb}"
                                  Style="{StaticResource ZusatzFelderListe}"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- [Zeile 7: Abschreibung] -->
        <GroupBox Grid.Row="7" Header="{Binding FeldAfa.Titel}"
                  Visibility="{Binding AfaBoxSichtbar, Converter={StaticResource BoolToVis}}">
            <StackPanel>
            <!-- Die Original-Felder: nur bei Ausgaben bedienbar (Einnahmen
                 kennen keine AfA; das MFC-Original versteckt die Controls
                 dort komplett) und nur, solange die Vorlage sie nicht sperrt.
                 IsEnabled sitzt hier und nicht an der GroupBox, damit
                 Zusatz-Felder der Vorlage in dieser Box bedienbar bleiben. -->
            <StackPanel IsEnabled="{Binding AfaBereichAktiv}"
                        ToolTip="{Binding AfaBereichHinweis}"
                        ToolTipService.ShowOnDisabled="True"
                        Visibility="{Binding FeldAfa.Sichtbar, Converter={StaticResource BoolToVis}}">
                <CheckBox Content="Abschreibung aktivieren"
                          IsChecked="{Binding AfaAktiviert}"
                          Margin="0,0,0,6"/>
                <Grid IsEnabled="{Binding AfaAktiviert}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Jahre:"
                               Style="{StaticResource LabelStyle}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              Text="{Binding AfaJahre}"
                              ItemsSource="{Binding AfaJahreOptionen}"
                              IsEditable="True"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Nr.:"
                               Style="{StaticResource LabelStyle}" Margin="12,0,8,0"/>
                    <TextBox Grid.Row="0" Grid.Column="3"
                             Text="{Binding AfaNr}" TextAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Restwert:"
                               Style="{StaticResource LabelStyle}" Margin="12,0,8,0"/>
                    <TextBox Grid.Row="0" Grid.Column="5"
                             Text="{Binding AfaRestwertText, UpdateSourceTrigger=LostFocus}"
                             TextAlignment="Right"/>

                    <!-- [Abgang buchen]: nur bei bestehender, mehrjaehriger AfA mit Restwert -->
                    <Button Grid.Row="0" Grid.Column="6"
                            Content="Abgang buchen"
                            Command="{Binding AbgangBuchenCommand}"
                            Visibility="{Binding AbgangButtonSichtbar, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="12,0,0,0" Padding="10,2"/>

                    <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                              Content="Degressiv"
                              IsChecked="{Binding AfaDegressiv}" Margin="0,4,0,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Satz %:"
                               Style="{StaticResource LabelStyle}" Margin="12,0,8,0"/>
                    <TextBox Grid.Row="1" Grid.Column="3"
                             Text="{Binding AfaSatz}" TextAlignment="Center"
                             IsEnabled="{Binding AfaDegressiv}"/>
                </Grid>
                <TextBlock Style="{StaticResource ErrorStyle}"
                           Text="{Binding AfaError}"/>
                <TextBlock Style="{StaticResource HintStyle}"
                           Text="{Binding AfaHinweis}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding FelderAfa}"
                          Style="{StaticResource ZusatzFelderListe}"/>
            </StackPanel>
        </GroupBox>

        <!-- [Zeile 8: aktive Buchungsvorlage]
             Sichtbar, solange eine erweiterte Vorlage aktiv ist: Vorschau
             der Zusatz-Buchungen, die beim Buchen entstehen (reine Anzeige;
             Eingaben macht man in den Zusatz-Feldern der Boxen oben),
             Summenzeile, Fehler und der Weg zurueck ("Vorlage entfernen"). -->
        <GroupBox Grid.Row="8" Margin="0,8,0,0" Padding="8"
                  Visibility="{Binding HatAktiveVorlage, Converter={StaticResource BoolToVis}}">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding VorlagenBereichTitel}"/>
                    <TextBlock Text="{Binding AktiveVorlageName}" FontWeight="SemiBold"/>
                </StackPanel>
            </GroupBox.Header>
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Zusatzzeilen}"
                              Focusable="False" IsTabStop="False"
                              Grid.IsSharedSizeScope="True"
                              Visibility="{Binding HatZusatzzeilen, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,3"
                                    Background="Transparent" ToolTip="{Binding Details}">
                                <StackPanel>
                                    <Grid x:Name="Zeile">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ZeileArt"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ZeileKonto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ZeileZiel"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ZeileBetrag"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ZeileMwst"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ArtText}"
                                                   Foreground="#777" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding KontoText}"
                                                   FontWeight="SemiBold" MaxWidth="260"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding BeschreibungText}"
                                                   Foreground="#555"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- Betrieb/Bestandskonto der Zeile, wenn sie
                                             von der Basis abweichen (zweiter Betrieb,
                                             Zielkonto einer Umbuchung) -->
                                        <TextBlock Grid.Column="3" Text="{Binding Ziel}"
                                                   Foreground="#1565C0" Margin="10,0,0,0"/>
                                        <TextBlock Grid.Column="4" Text="{Binding BetragAnzeige}"
                                                   TextAlignment="Right" Margin="10,0,0,0"/>
                                        <TextBlock Grid.Column="5" Text="{Binding MwstAnzeige}"
                                                   Foreground="#777" TextAlignment="Right"
                                                   Margin="10,0,0,0"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource VorschauStyle}"
                                               Margin="0,1,0,0" Text="{Binding Hinweis}"/>
                                    <TextBlock Style="{StaticResource ErrorStyle}"
                                               Text="{Binding ZeilenFehler}"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- Zeile, die nicht gebucht wird: blass -->
                                <DataTrigger Binding="{Binding Uebersprungen}" Value="True">
                                    <Setter TargetName="Zeile" Property="Opacity" Value="0.45"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- [Summenzeile + Vorlage entfernen] -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GruppenSummeText}" Foreground="#333"
                                   TextWrapping="Wrap"
                                   ToolTip="Alle Buchungen, die entstehen, zusammengefasst nach dem Merkmal, in dem sie sich unterscheiden: Betrieb, Bestandskonto, Konto oder Steuersatz. Einnahmen und Ausgaben werden nie zusammengezählt, weil sich Zeilen einer Buchungsgruppe gegenseitig aufheben können."/>
                        <TextBlock Style="{StaticResource ErrorStyle}"
                                   Text="{Binding GruppenFehlerText}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Vorlage entfernen" Padding="8,2"
                            VerticalAlignment="Top" Margin="8,0,0,0"
                            Command="{Binding VorlageEntfernenCommand}"
                            ToolTip="Die Buchungsvorlage ablegen: Zusatz-Felder und Zusatz-Buchungen entfallen, alle Felder sind wieder frei bedienbar. Die schon eingetragenen Werte bleiben stehen."/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Fortschritts-Overlay des Waehrungsrechners ueber Beschreibung (Zeile 3)
             und Betrag (Zeile 4): waehrend der asynchronen Kursabfrage
             sichtbar, mit Abbrechen-Moeglichkeit. Als letztes Grid-Kind = liegt
             optisch oben (Issue #21: keine einfrierende/haengende Oberflaeche). -->
        <Border Grid.Row="3" Grid.RowSpan="2" Panel.ZIndex="100"
                Background="#D8FFFFFF" CornerRadius="3"
                Visibility="{Binding UmrechnungLaeuft, Converter={StaticResource BoolToVis}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" BorderBrush="#1565C0" BorderThickness="1"
                    CornerRadius="4" Padding="16,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="130" Height="14"
                                 VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding UmrechnungStatus}" Margin="12,0,12,0"
                               VerticalAlignment="Center" Foreground="#333"/>
                    <Button Content="Abbrechen" Padding="10,3" Focusable="False"
                            Command="{Binding AbbrechenUmrechnungCommand}"/>
                </StackPanel>
            </Border>
        </Border>
        </Grid>
        </ScrollViewer>

        <!-- [Fehler von Feldern, die die Vorlage ausblendet]
             Ausserhalb des Scrollbereichs, direkt ueber den Knoepfen: sonst
             bliebe "Buchen" scheinbar grundlos wirkungslos. -->
        <TextBlock Grid.Row="1" Style="{StaticResource ErrorStyle}"
                   Text="{Binding VersteckteFehlerText}"/>

        <!-- [Buttons] -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{Binding OkButtonText}"
                    Command="{Binding OkCommand}"
                    Width="100" Height="32"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,8,0"/>
            <Button Content="Weiterbuchen"
                    Command="{Binding WeiterbuchenCommand}"
                    Width="110" Height="32"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Visibility="{Binding WeiterbuchenSichtbar, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,8,0"/>
            <Button Content="Abbrechen"
                    Command="{Binding AbbrechenCommand}"
                    Width="100" Height="32"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
